# Derive the owner UID from the /jumpstart/users/UID/ path, as systemd does
# from user-UID.slice: polkit treats a missing owner UID as fatal and then
# refuses every org.freedesktop.login1.* action (Power Off, Restart). Done in
# cg_path_get_owner_uid() so every sd_pid_get_owner_uid/sd_peer_get_owner_uid/
# sd_bus_creds_get_owner_uid caller is covered; parse_uid() tolerates a NULL
# ret_uid. Applies with `patch -p1` after elogind-session-state-check.patch.
--- a/src/basic/cgroup-util.c
+++ b/src/basic/cgroup-util.c
@@ -1532,6 +1532,28 @@
         if (parse_uid(start, ret_uid) < 0)
                 return -ENXIO;
 #else // 0
+
+#if 1 /// derive the owner UID from a Jumpstart per-user cgroup path
+        /* elogind's flat cgroup layout names the first cgroup component a
+         * session, so a process of a per-user manager is reported in a session
+         * called "jumpstart"; derive the owner UID from the path instead. */
+        {
+                const char *e, *n;
+                _cleanup_free_ char *uid_str = NULL;
+
+                e = path_startswith(path, "/jumpstart/users/");
+                if (e) {
+                        n = strchrnul(e, '/');
+                        if (n > e) {
+                                uid_str = strndup(e, n - e);
+                                if (!uid_str)
+                                        return -ENOMEM;
+                                if (parse_uid(uid_str, ret_uid) >= 0)
+                                        return 0;
+                        }
+                }
+        }
+#endif // 1
         r = cg_path_get_session(path, &session);
         if (r < 0)
                 return r;
