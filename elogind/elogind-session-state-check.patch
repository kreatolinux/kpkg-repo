--- a/src/libelogind/sd-login/sd-login.c
+++ b/src/libelogind/sd-login/sd-login.c
@@ -38,6 +38,26 @@
  *    machine, session does not exist         → -ENXIO
  *    requested metadata on object is missing → -ENODATA
  */
+
+#if 1 /// only report sessions elogind actually knows
+/* Flat cgroup layout: a process of a per-user manager would be reported in a
+ * session called "jumpstart". systemd answers -ENODATA outside a session
+ * scope, so require the session state file. */
+static int known_session_or_enxio(int r, char **session) {
+        _cleanup_free_ char *p = NULL;
+
+        if (r < 0 || !session || !*session)
+                return r;
+        p = path_join("/run/systemd/sessions", *session);
+        if (!p)
+                return -ENOMEM;
+        if (access(p, F_OK) < 0) {
+                *session = mfree(*session);
+                return -ENXIO;
+        }
+        return r;
+}
+#endif // 1
 
