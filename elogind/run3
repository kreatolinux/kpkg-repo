name: "elogind"
version: "257.15"
release: "2"
description: "systemd-logind, extracted to be a standalone daemon"
sources:
 - "https://github.com/elogind/elogind/archive/refs/tags/v${version}.tar.gz"
sha256sum:
 - "20e3d968e016c9f6e1292ec325b6331ac2d1306e95a332fb3265838c811e4bf5"
depends:
 - "dbus"
 - "linux-pam"
 - "python-jinja2"
 - "util-linux"
 - "gperf"
 - "eudev"
build_depends:
 - "meson"
 - "ninja"
replaces:
 - "systemd"

prepare {
 exec "sed -i \"/relative_source_path = /c relative_source_path = '..'\" meson.build"
 exec "sed -i '/--relative-to=/,+2d' meson.build"
 exec "sed -i '/SYSTEMD_TEST_DATA=/s/%q/%s/g' meson.build"
}

build {
 macro build --libdir=/usr/lib -Dman=false -Dtests=false -Ddbuspolicydir=/etc/dbus-1/system.d
}

package {
 macro package
 exec "mkdir -p $ROOT/usr/lib/pkgconfig $ROOT/usr/include/systemd"
 exec "ln -s libelogind.pc $ROOT/usr/lib/pkgconfig/libsystemd.pc"
 exec "ln -sn elogind $ROOT/usr/include/systemd"
}


