name: "libsecret"
version: "0.21.8.2"
release: "2"
description: "A GObject-based library for accessing the Secret Service API"
sources:
 - "https://download.gnome.org/sources/libsecret/${version.split('.')[0:2].join('.')}/libsecret-${version}.tar.xz"
sha256sum:
 - "142948339c5b971d8f6a8c7099521f6fd319b6fe73d2694b4e6d3310ed28b6e6"
depends:
 - "glib"
 - "libgcrypt"
 - "gobject-introspection"
 - "vala"
build_depends:
 - "meson"
 - "ninja"

build {
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dgtk_doc=false -Dmanpage=false -Dtest_setup=disabled -Dbash_completion=disabled
}

package {
 macro package
}


