name: "freetype"
version: "2.15.0"
release: "3"
description: "FriBidi is an implementation of Unicode Bidirectional Algorithm"
sources:
  - "https://download-mirror.savannah.gnu.org/releases/freetype/freetype-$version.tar.gz"
sha256sum:
  - "9186627467a616d9a9e3e574748ac0c45fa77398e6364edef3041a8ba8d92f64"
depends:
  - "libpng"
build_depends:
  - "ninja"
  - "meson"

build {
  exec "meson  --prefix=/usr --libdir=/usr/lib -Dharfbuzz=disabled  -Dbzip2=disabled  . output"
  exec "ninja -C output"
}

package {
  exec "DESTDIR=$ROOT ninja -C output install"
}

