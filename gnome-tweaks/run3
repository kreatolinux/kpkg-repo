name: "gnome-tweaks"
version: "49.0"
release: "1"
description: "GNOME Tweaks app"
sources:
 - "https://github.com/GNOME/gnome-tweaks/archive/refs/tags/${version}.tar.gz"
sha256sum:
 - "a9ca755f5bc1540c8970f02dfcaf7782e2efb31314ae19e8d6667dde2548d1a5"
depends:
 - "libtool"
 - "pygobject"
 - "python"
 - "gnome-settings-daemon"
 - "glib"
 - "gtk3"
 - "gnome-desktop"
 - "libhandy"
 - "pango"
 - "gsettings-desktop-schemas"
 - "gnome-shell"
 - "mutter"
build_depends:
 - "meson"

build {
  # gdk-pixbuf resolves file types through the compiled shared MIME
  # database, and the build sandbox only carries its XML sources.
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"
 macro build 
}

package {
 macro package
}

postinstall {
 print "Installing new Schemas"
 exec "glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true"
 print "Updating icon cache..."
 exec "gtk-update-icon-cache -qtf /usr/share/icons/hicolor 2>/dev/null || true"
}


