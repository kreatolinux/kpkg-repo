name: "xdg-desktop-portal-gtk"
version: "1.15.3"
release: "1"
description: "GTK backend for xdg-desktop-portal"
sources:
 - "https://github.com/flatpak/xdg-desktop-portal-gtk/releases/download/${version}/xdg-desktop-portal-gtk-${version}.tar.xz"
sha256sum:
 - "47a3743d2419a8601e691db37e85bb5fac5ae4b26842177065cd5f22ada23b37"
depends:
 - "xdg-desktop-portal"
 - "gtk3"
 - "gnome-desktop"
build_depends:
 - "meson"
 - "ninja"

build {
  # gdk-pixbuf resolves file types through the compiled shared MIME
  # database, and the build sandbox only carries its XML sources.
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"
 macro build --meson
}

package {
 macro package
}


