name: "gnome-control-center"
version: "50.4"
release: "3"
description: "GNOME Control Center"
extract: false
sources:
  - "https://download.gnome.org/sources/gnome-control-center/${version.split('.')[0]}/gnome-control-center-$version.tar.xz"
  - "https://raw.githubusercontent.com/kreatolinux/assets/master/klinux_pixmap.png"
  - "https://gitlab.gnome.org/GNOME/tecla/-/archive/47.0/tecla-47.0.tar.gz"
  - "https://gitlab.gnome.org/GNOME/libgxdp/-/archive/1fe6de799f39b3126e8d0db66fa4f16c10fd9bd6/libgxdp-1fe6de799f39b3126e8d0db66fa4f16c10fd9bd6.tar.gz"
sha256sum:
  - "5856c73999bedf45e74f73bac3d61e2b5ec1689f8bcf1943737baeee8204fb11"
  - "6e1fc322ed757a024a39a80a8de43d184323e2e781aa21cf618fc67655e6cb28"
  - "295c3f205b4f595ddb9b6e9625bcf467075614ff2ee533fe7f4739d99b6bac65"
  - "5fd2eba5c40666663039bb0b8f3a4b256808daa045de7ef33b7ec7360e666467"
depends:
  - "libnma"
  - "modemmanager"
  - "cups"
  - "samba"
  - "gcr-4"
  - "gnome-online-accounts"
  - "accountsservice"
  - "colord-gtk"
  - "libgtop"
  - "udisks"
  - "libpwquality"
  - "gnome-settings-daemon"
  - "gsound"
  - "gnome-bluetooth"
  - "ibus"
  - "libadwaita"
  - "upower"
  - "libwacom"
  - "libsecret"
  - "geoclue"
build_depends:
  - "meson"
  - "ninja"
  - "blueprint-compiler"

prepare {
  exec "tar -xf gnome-control-center-$version.tar.xz"
  exec "tar -xf tecla-47.0.tar.gz"
  exec "tar -xf libgxdp-1fe6de799f39b3126e8d0db66fa4f16c10fd9bd6.tar.gz"
  cd "gnome-control-center-$version"
  exec "rm -rf subprojects/tecla subprojects/libgxdp"
  exec "mv ../tecla-47.0 subprojects/tecla"
  exec "mv ../libgxdp-1fe6de799f39b3126e8d0db66fa4f16c10fd9bd6 subprojects/libgxdp"
}

build {
  exec "meson setup --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nodownload -Dtests=false -Ddocumentation=false -Dsnap=false -Dmalcontent=false -Ddistributor_logo=/usr/share/pixmaps/klinux_logo.png -Ddark_mode_distributor_logo=/usr/share/pixmaps/klinux_logo.png build"
  exec "ninja -C build"
}

package {
  exec "DESTDIR=$ROOT ninja -C build install"
  exec "mkdir -p $ROOT/usr/share/pixmaps"
  exec "cp ../klinux_pixmap.png $ROOT/usr/share/pixmaps/klinux_logo.png"
}
