name: "libxkbcommon"
version: "1.13.2"
release: "1"
description: "Keyboard compiler and support library"
sources:
  - "https://github.com/xkbcommon/libxkbcommon/archive/refs/tags/xkbcommon-$version.tar.gz"
sha256sum:
  - "acc4d5f7c3cbba5f9f8d08d8bdbeede84ecede46792f47929aa9321873385528"
depends:
  - "wayland"
  - "wayland-protocols"
  - "libxcb"
  - "libxml2"
  - "xkeyboard-config"
build_depends:
  - "meson"
  - "ninja"
  - "bison"

build {
  macro build --libdir=/usr/lib --default-library=shared -Denable-x11=true -Dxkb-config-root=/usr/share/X11/xkb -Dx-locale-root=/usr/share/X11/locale -Denable-docs=false
}

package {
  macro package
}
