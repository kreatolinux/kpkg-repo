name: "gettext"
version: "0.22.5"
release: "1"
description: "Gettext contains utilities for localization."
sources:
 - "https://ftp.gnu.org/gnu/gettext/gettext-${version}.tar.xz"
sha256sum:
 - "fe10c37353213d78a5b83d48af231e005c4da84db5ce88037d88355938259640"
depends:
 - "attr"
 - "libxml2"
build_depends:
 - "gmake"

build {
 exec "./configure --prefix=/usr"
 # Build libtextstyle first: gettext-tools copies textstyle.h and friends
 # out of libtextstyle/lib during its build, and on a bootstrap root the
 # top-level ordering did not reliably produce them before gettext-tools
 # compiled (textstyle.h: No such file or directory).
 exec "make -C libtextstyle"
 exec "make"
}

package {
 macro package
 exec "rm -rf $ROOT/usr/share/info/dir"
}


