name: "gettext"
version: "1.0"
release: "2"
description: "Gettext contains utilities for localization."
sources:
 - "https://ftp.gnu.org/gnu/gettext/gettext-${version}.tar.xz"
sha256sum:
 - "71132a3fb71e68245b8f2ac4e9e97137d3e5c02f415636eb508ae607bc01add7"
depends:
 - "attr"
 - "acl"
 - "libxml2"
build_depends:
 - "gmake"

build {
 exec "./configure --prefix=/usr"
 # Build libtextstyle first, then copy its headers into gettext-tools/src
 # ourselves. gettext-tools normally fetches them via a BUILT_SOURCES rule
 # that re-invokes make inside libtextstyle, and on a bootstrap root that
 # rule does not produce the files before gettext-tools/src compiles
 # (textstyle.h: No such file or directory). The copy below is exactly
 # what install-nobase_includeHEADERS does.
 exec "make -C libtextstyle"
 exec "mkdir -p gettext-tools/src/textstyle"
 exec "cp libtextstyle/lib/textstyle.h gettext-tools/src/"
 exec "cp libtextstyle/lib/textstyle/*.h gettext-tools/src/textstyle/"
 exec "make"
}

package {
 macro package
 exec "rm -rf $ROOT/usr/share/info/dir"
}


