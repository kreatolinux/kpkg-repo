name: "nautilus"
version: "51.1"
release: "3"
description: "File manager of GNOME"
sources:
 - "https://download.gnome.org/sources/nautilus/${version.split('.')[0]}/nautilus-${version}.tar.xz"
sha256sum:
 - "a703bc152d18d161d9dab957e2390a36e6246bb5c24de7b15c9624fcfa2f2816"
depends:
 - "bubblewrap"
 - "dconf"
 - "libgexiv2"
 - "gdk-pixbuf"
 - "gnome-autoar"
 - "gnome-desktop"
 - "gst-plugins-base"
 - "libnotify"
 - "libadwaita"
 - "libportal"
 - "libseccomp"
 - "tinysparql"
 - "glycin"
 - "desktop-file-utils"
 - "adwaita-icon-theme"
build_depends:
 - "meson"
 - "vala"
 - "gobject-introspection"
 - "blueprint-compiler"

build {
 macro build --libdir=/usr/lib --wrap-mode=nodownload -Dcloudproviders=disabled -Dselinux=disabled -Dtests=none
}

package {
 macro package
}

postinstall {
 exec "glib-compile-schemas /usr/share/glib-2.0/schemas"
}


