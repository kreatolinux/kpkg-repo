name: "nautilus"
version: "51.1"
release: "1"
description: "File manager of GNOME"
sources:
 - "https://download.gnome.org/sources/nautilus/${version.split('.')[0]}/nautilus-${version}.tar.xz"
 - "nautilus-optional-localsearch.patch"
sha256sum:
 - "a703bc152d18d161d9dab957e2390a36e6246bb5c24de7b15c9624fcfa2f2816"
 - "1c5659936c3ddf6c60fb3d8ac40f78754725b501a2959ecba9d7d911f7f2bbb7"
depends:
 - "libtool"
 - "bubblewrap"
 - "dconf"
 - "libgexiv2"
 - "gdk-pixbuf"
 - "gnome-autoar"
 - "gnome-desktop"
 - "gst-plugins-base"
 - "libnotify"
 - "libadwaita"
 - "libportal"
 - "libseccomp"
 - "tinysparql"
 - "glycin"
 - "desktop-file-utils"
 - "adwaita-icon-theme"
build_depends:
 - "meson"
 - "vala"
 - "gobject-introspection"
 - "blueprint-compiler"

prepare {
  # nautilus aborts without the localsearch schema, so the patch makes it
  # optional.
  exec "patch -p1 < ../nautilus-optional-localsearch.patch"
}

build {
  # gdk-pixbuf resolves file types through the compiled shared MIME
  # database, and the build sandbox only carries its XML sources.
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"
 macro build --libdir=/usr/lib --wrap-mode=nodownload -Dcloudproviders=disabled -Dselinux=disabled -Dtests=none
}

package {
 macro package
}

postinstall {
 exec "glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true"
 exec "gtk-update-icon-cache -qtf /usr/share/icons/hicolor 2>/dev/null || true"
 exec "update-desktop-database -q /usr/share/applications 2>/dev/null || true"
}


