name: "gtk3"
version: "3.24.43"
release: "2"
description: "gtk3"
sources:
 - "https://download.gnome.org/sources/gtk+/${version.split('.')[0:2].join('.')}/gtk+-${version}.tar.xz"
sha256sum:
 - "7e04f0648515034b806b74ae5d774d87cffb1a2a96c468cb5be476d51bf2f3c7"
depends:
 - "atk"
 - "libx11"
 - "cantarell-fonts"
 - "libxcomposite"
 - "libxrandr"
 - "libxrender"
 - "gdk-pixbuf"
 - "shared-mime-info"
 - "libepoxy"
 - "pango"
 - "iso-codes"
 - "libxkbcommon"
 - "gobject-introspection"
 - "wayland"
 - "wayland-protocols"
build_depends:
 - "meson"
 - "ninja"

build {
  # gdk-pixbuf is built with -Dbuiltin_loaders=all, so its loaders are
  # compiled into the library and no loaders.cache is generated. The
  # sandbox does not carry libgdk_pixbuf at all, so glib-compile-resources
  # cannot decode the Adwaita PNG assets. Generate a cache from the real
  # root and point the build at it.
  env XDG_DATA_DIRS="/usr/share"
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"

 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dman=false -Dx11_backend=true -Dwayland_backend=true -Ddemos=false -Dexamples=false -Dtests=false -Dinstalled_tests=false
}

package {
 macro package
}


