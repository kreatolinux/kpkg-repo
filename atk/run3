name: "atk"
version: "2.62.1"
release: "1"
description: "Base DBus XML interfaces for accessibility, the accessibility registry daemon, and atspi library"
sources:
 - "https://download.gnome.org/sources/at-spi2-core/${version.split('.')[0:2].join('.')}/at-spi2-core-${version}.tar.xz"
sha256sum:
 - "cca6b6a86e4389d89b370288761ce2385ddeceb10c4412da78689bc30c88af2d"
depends:
 - "libx11"
 - "libxtst"
 - "glib"
 - "gobject-introspection"
 - "libffi"
 - "dbus"
build_depends:
 - "pkgconf"
 - "meson"
 - "ninja"
 - "python-setuptools"

build {
 # 2.62 flips default_bus to dbus-broker. dbus-broker is not packaged here, so
 # find_program('dbus-broker-launch') fails and the launcher is built exactly
 # as before; pin dbus-daemon so a future dbus-broker package cannot silently
 # turn libsystemd into a hard dependency of the accessibility bus.
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dintrospection=enabled -Ddocs=false -Ddefault_bus=dbus-daemon
}

package {
 macro package
}


