name: "upower"
version: "1.91.5"
release: "2"
description: "Power management support for DeviceKit"
sources:
 - "https://gitlab.freedesktop.org/upower/upower/-/archive/v${version}/upower-v${version}.tar.gz"
sha256sum:
 - "d900f175e39fbc0dfd8632f7c70606e10f79903ee4171d199aa777dfa3a396e2"
depends:
 - "libgudev"
 - "eudev"
 - "gobject-introspection"
build_depends:
 - "meson"

build {
 macro build --libdir=/usr/lib --wrap-mode=nodownload -Dgtk-doc=false -Dman=false -Dintrospection=enabled -Dsystemdsystemunitdir=/usr/lib/systemd/system -Dudevrulesdir=/usr/lib/udev/rules.d -Dudevhwdbdir=/usr/lib/udev/hwdb.d -Dinstalled_tests=false -Didevice=disabled
}

package {
 macro package
}


