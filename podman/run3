name: "podman"
version: "6.2.0"
release: "1"
description: "A tool for managing OCI containers and pods"
sources:
 - "https://github.com/containers/podman/archive/refs/tags/v${version}.tar.gz"
sha256sum:
 - "cb182273c5c5e3ea079f8f88a9a30a574d247f80e0b9dd9c02df1d2e6f6f3705"
depends:
 - "libseccomp"
 - "gpgme"
 - "btrfs-progs"
 - "conmon"
 - "crun"
 - "lvm2"
build_depends:
 - "go"
 - "gmake"

build {
  env BUILDTAGS="seccomp"
  exec "make -j${exec('nproc').output()}"
}

package {
 exec "sed -i 's/-sfr/-sf/g' Makefile"
 macro package
}


