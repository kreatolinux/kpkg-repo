name: "podman"
version: "6.1.3"
release: "1"
description: "A tool for managing OCI containers and pods"
sources:
 - "https://github.com/containers/podman/archive/refs/tags/v${version}.tar.gz"
sha256sum:
 - "6253aee14e573f747ca77e5a83a0df4ef9c2f609604f56715070ed06b6f9ddd8"
depends:
 - "libseccomp"
 - "gpgme"
 - "btrfs-progs"
 - "conmon"
 - "crun"
 - "lvm2"
build_depends:
 - "go"
 - "gmake"

build {
  env BUILDTAGS="seccomp"
  exec "make -j${exec('nproc').output()}"
}

package {
 exec "sed -i 's/-sfr/-sf/g' Makefile"
 macro package
}


