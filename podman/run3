name: "podman"
version: "6.1.4"
release: "1"
description: "A tool for managing OCI containers and pods"
sources:
 - "https://github.com/containers/podman/archive/refs/tags/v${version}.tar.gz"
sha256sum:
 - "200fd9b4b6d820cae24fc99d8e290ec945512365cf3cda8283b3905c0c284ea8"
depends:
 - "libseccomp"
 - "gpgme"
 - "btrfs-progs"
 - "conmon"
 - "crun"
 - "lvm2"
build_depends:
 - "go"
 - "gmake"

build {
  env BUILDTAGS="seccomp"
  exec "make -j${exec('nproc').output()}"
}

package {
 exec "sed -i 's/-sfr/-sf/g' Makefile"
 macro package
}


