name: "geoclue"
version: "2.8.2"
release: "3"
description: "A D-Bus geoinformation service"
sources:
 - "https://gitlab.freedesktop.org/geoclue/geoclue/-/archive/${version}/geoclue-${version}.tar.gz"
sha256sum:
 - "5435f7d48105fe89a4259f807658281e854881267254bcd4eeac6e26c222055b"
depends:
 - "libnotify"
 - "libsoup"
 - "json-glib"
 - "glib"
build_depends:
 - "meson"

build {
 macro build --sysconfdir=/etc -Dlibdir=lib --wrap-mode=nodownload -Dmodem-gps-source=false -D3g-source=false -Dcdma-source=false -Dgtk-doc=false -Dnmea-source=false
}

package {
 macro package -Dlibdir=lib
}


