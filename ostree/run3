name: "ostree"
version: "2026.4"
release: "3"
description: "Operating system and container binary deployment and upgrades"
sources:
  - "https://github.com/ostreedev/ostree/releases/download/v$version/libostree-$version.tar.xz"
sha256sum:
  - "b26c9016eb03bb4ee52cc00c642d56e00fc79ae7faac6bf4aa317d7451339ef7"
depends:
  - "xz-utils"
  - "fuse"
  - "e2fsprogs"
  - "gpgme"
  - "libarchive"
  - "curl"
  - "glib"
  - "libsoup"
build_depends:
  - "gmake"

build {

  if ${exec("command -v systemctl")}.exit() != 0 {
    local extraArgs = "--without-libsystemd"
  }

  macro build $extraArgs --disable-man --disable-rofiles-fuse --with-curl --with-gpgme --prefix=/usr
  exec "make"
}

package {
  exec "make DESTDIR=$ROOT install"
}

