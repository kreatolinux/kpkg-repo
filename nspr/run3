name: "nspr"
version: "4.40"
release: "1"
description: "nspr"
sources:
  - "https://archive.mozilla.org/pub/nspr/releases/v$version/src/nspr-$version.tar.gz"
sha256sum:
  - "c0c1884c627f3db7a783f7c7314c695226b2043696791d15519e7e0578c19bdc"
build_depends:
  - "gmake"

build {

  cd "nspr"

  local arch = "${exec("uname -m").output()}"
  if "$arch" == "x86_64" || "$arch" == "aarch64" {
    local extraArgs = "--enable-64bit"
  }

  macro build --prefix=/usr  --with-pthreads  --with-mozilla $extraArgs
  exec "make"
}

package {
  exec "make DESTDIR=$ROOT install"
}

