name: "grub"
version: "2.14"
release: "7"
description: "The GNU Grub Bootloader"
sources:
  - "https://ftp.gnu.org/gnu/grub/grub-$version.tar.xz"
sha256sum:
  - "bc8d3c73535b8838d8c8e2654d73edc4e6ae8c8acdb45d5df5dc9a1547446d43"
depends:
  - "flex"
  - "freetype"
  - "pigz"
build_depends:
  - "gmake"
depends_grub_efi:
  - "efibootmgr"

func build_grub_efi {
  macro build --disable-efiemu --disable-werror --prefix=/usr --sysconfdir=/etc --with-platform=efi
  exec "make"
}

build {
  # GRUB places .text at 0x9000 with $(TARGET_IMG_BASE_LDOPT),0x9000, and picks
  # that variable by asking whether the linker accepts -Wl,--image-base: a PE
  # option. GNU ld on ELF accepts it and ignores it -- with the warning
  #
  #   app: warning: this may be an error in the future
  #
  # -- so the kernel links with no base at all, .text lands at 0x9074, and
  # grub-mkimage refuses the result:
  #
  #   kernel.img is miscompiled: its start address is 0x9074 instead of 0x9000
  #
  # That breaks every BIOS image, not just live ISOs. The tarball ships a
  # generated configure with the PE answer baked in, so correct it before
  # running it and let GRUB use the ELF-appropriate -Wl,-Ttext.
  exec "sed -i 's|TARGET_IMG_BASE_LDOPT=\"-Wl,--image-base\"|TARGET_IMG_BASE_LDOPT=\"-Wl,-Ttext\"|' configure"
  macro build --disable-efiemu --disable-werror --prefix=/usr --sysconfdir=/etc
  exec "make"
}

package {
  exec "make DESTDIR=\"$ROOT\" install"
}

