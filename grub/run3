name: "grub"
version: "2.14"
release: "6"
description: "The GNU Grub Bootloader"
sources:
  - "https://ftp.gnu.org/gnu/grub/grub-$version.tar.xz"
sha256sum:
  - "bc8d3c73535b8838d8c8e2654d73edc4e6ae8c8acdb45d5df5dc9a1547446d43"
depends:
  - "flex"
  - "freetype"
  - "pigz"
build_depends:
  - "gmake"
depends_grub_efi:
  - "efibootmgr"

func build_grub_efi {
  macro build --disable-efiemu --disable-werror --prefix=/usr --sysconfdir=/etc --with-platform=efi
  exec "make"
}

build {
  # binutils' -z separate-code puts .text on its own page, so kernel.img starts
  # at 0x9074 instead of the 0x9000 the BIOS loader requires, and grub-mkrescue
  # refuses to build any image at all:
  #
  #   kernel.img is miscompiled: its start address is 0x9074 instead of 0x9000
  #
  # i386-pc is the BIOS platform, so this is not specific to live ISOs: every
  # `krep disk --bootloader=grub` image for amd64 inherits it.
  #
  # -fcf-protection=none is belt and braces: a CET .note.gnu.property section
  # would shift .text the same way. kernel.img built without it carries no such
  # section, so it is not what caused this, but nothing should reintroduce it.
  env TARGET_LDFLAGS="$TARGET_LDFLAGS -Wl,-z,noseparate-code"
  env TARGET_CFLAGS="$TARGET_CFLAGS -fcf-protection=none"
  macro build --disable-efiemu --disable-werror --prefix=/usr --sysconfdir=/etc
  exec "make"
}

package {
  exec "make DESTDIR=\"$ROOT\" install"
}

