name: "telepathy-glib"
version: "0.24.2"
release: "2"
description: "glib bindings for telepathy"
sources:
 - "https://telepathy.freedesktop.org/releases/telepathy-glib/telepathy-glib-${version}.tar.gz"
sha256sum:
 - "b0a374d771cdd081125f38c3abd079657642301c71a543d555e2bf21919273f0"
depends:
 - "dbus-glib"
 - "libxslt"
build_depends:
 - "gobject-introspection"
 - "diffutils"
 - "gmake"

prepare {
 exec "sed -i 's/g_ptr_array_new_full (i, tp_value_array_free)/g_ptr_array_new_full (i, (GDestroyNotify) tp_value_array_free)/' telepathy-glib/protocol.c"
}

build {
 macro build --configure
}

package {
 macro package
}

