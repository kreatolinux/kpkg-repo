name: "gcr-4"
version: "4.4.1"
release: "3"
description: "A library for displaying certificates and crypto UI"
sources:
 - "https://download.gnome.org/sources/gcr/${version.split('.')[0:2].join('.')}/gcr-${version}.tar.xz"
sha256sum:
 - "c4442c15d4330f17a1f5194df08c576877af68412ab2521446a93bd5e24c931b"
depends:
 - "glib"
 - "gtk4"
 - "libgcrypt"
 - "p11-kit"
 - "gnupg"
 - "libsecret"
 - "openssh"
 - "libxslt"
build_depends:
 - "meson"
 - "gobject-introspection"

build {
 macro build -Dlibdir=lib -Dgtk_doc=false --wrap-mode=nodownload
}

package {
 macro package -Dlibdir=lib
}


