[Unit]
Description=User folders update
Documentation=man:xdg-user-dirs-update(1)
# Upstream's unit plus RemainAfterExit, installed over it. Wanted by
# graphical-session-pre.target, which is stopped at logout, so it runs once per
# login; default.target is started once per user manager instead.
Before=graphical-session-pre.target

[Service]
Type=oneshot
# No ConditionPathExists=: it must run even when user-dirs.dirs exists, to
# recreate directories the user deleted and reassign removed ones.
RemainAfterExit=yes
ExecStart=/usr/bin/xdg-user-dirs-update

[Install]
WantedBy=graphical-session-pre.target
