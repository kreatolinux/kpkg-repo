name: "xdg-user-dirs"
version: "0.20"
release: "1"
description: "Tool to help manage the well-known user directories (Desktop, Documents, Downloads, Music, Pictures, Videos, ...)"
license:
  - "GPL-2.0-or-later"
# 0.20 (2026-04-08) is the current release, and the first one with no
# configure script: upstream dropped Automake and ships Meson only, so this is
# a meson recipe even though xdg-user-dirs is traditionally an autotools
# package. The sum is the one published next to the tarball
# (xdg-user-dirs-0.20.tar.xz.sha256sum).
#
# The two files after it are recipe-local sources: the Kreato unit and its
# preset. kpkg stages local files by basename into $SRCDIR, so they land next
# to the extracted tree. Their sums are SKIP because they are edited here, not
# downloaded.
sources:
  - "https://user-dirs.freedesktop.org/releases/xdg-user-dirs-${version}.tar.xz"
  - "xdg-user-dirs.service"
  - "60-xdg-user-dirs.preset"
sha256sum:
  - "b8e34286278f4fef3e1bfe9685c395ccc0eb50c14d3a2fb4953dd00fbfd3af39"
  - "SKIP"
  - "SKIP"
# Extract by hand in prepare: with extract enabled kpkg autocds into the single
# top-level directory, and the stages below cd explicitly instead.
extract: false
# No runtime dependencies: both binaries link only libc. glibc has ngettext, so
# upstream compiles gettext support in and never links libintl.
build_depends:
  - "meson"
  - "ninja"
  # msgfmt, for the 80 translations (-Dnls=true, the upstream default).
  - "gettext"
  # Man pages: upstream generates them from DocBook XML with xsltproc --nonet,
  # so the stylesheets and the DTD must be installed (see the build stage).
  - "libxslt"
  - "docbook-xsl"
  - "docbook-xml"

prepare {
  exec "tar -xJf xdg-user-dirs-$version.tar.xz"
}

build {
  # Upstream's man pages are generated by xsltproc --nonet from
  # http://docbook.sourceforge.net/release/xsl/current/manpages/docbook.xsl,
  # and the XML sources reference the DocBook 4.3 DTD by URL. Resolving those
  # needs an XML catalog, and kpkg installs build dependencies with their
  # postinstalls skipped, so docbook-xml's /etc/xml/catalog does not exist
  # inside the build sandbox: without one, every man page fails with
  # "Attempt to load network entity". Build a private catalog in $SRCDIR from
  # the stylesheets and DTD that are installed, and point xsltproc at it with
  # XML_CATALOG_FILES. Nothing outside the build tree is touched.
  # NOTE for anyone editing this: Kongue substitutes $name and ${name} in exec
  # strings *before* the shell runs, using the recipe's own variables (and the
  # environment), so a shell variable would be replaced by an empty string --
  # `sh -c 'X=1 && echo "$X"'` really runs `echo ""`, and even \$X does not
  # survive. Only $(command) substitution and the recipe's own variables
  # ($SRCDIR, $ROOT, $version, $v) may appear here. That is why the catalog is
  # built with one exec per entry instead of a shell script with variables.
  exec "xmlcatalog --noout --create \"$SRCDIR/docbook-catalog.xml\""
  # The stylesheet version is globbed rather than hardcoded: docbook-xsl is a
  # separate package that may be bumped.
  for base in ["http://docbook.sourceforge.net/release/xsl/current", "$(ls -d /usr/share/xml/docbook/xsl-stylesheets-* | tail -1)"] {
    exec "xmlcatalog --noout --add rewriteSystem \"$base\" \"$(ls -d /usr/share/xml/docbook/xsl-stylesheets-* | tail -1)\" \"$SRCDIR/docbook-catalog.xml\""
    exec "xmlcatalog --noout --add rewriteURI \"$base\" \"$(ls -d /usr/share/xml/docbook/xsl-stylesheets-* | tail -1)\" \"$SRCDIR/docbook-catalog.xml\""
  }
  # docbook-xml's own catalog maps 4.1.2 through 4.4 onto the 4.5 DTD; do the
  # same so any of the five URLs the man sources may name resolves.
  for v in ["4.1.2", "4.2", "4.3", "4.4", "4.5"] {
    exec "xmlcatalog --noout --add rewriteSystem \"http://www.oasis-open.org/docbook/xml/$v\" \"$(ls -d /usr/share/xml/docbook/xml-dtd-* | tail -1)\" \"$SRCDIR/docbook-catalog.xml\""
    exec "xmlcatalog --noout --add rewriteURI \"http://www.oasis-open.org/docbook/xml/$v\" \"$(ls -d /usr/share/xml/docbook/xml-dtd-* | tail -1)\" \"$SRCDIR/docbook-catalog.xml\""
  }
  env XML_CATALOG_FILES="$SRCDIR/docbook-catalog.xml"
  cd "xdg-user-dirs-$version"
  macro build --meson -Ddocs=true -Dnls=true
}

package {
  # No cd: Kongue keeps currentDir across stages, and the build stage already
  # left it in xdg-user-dirs-$version (a second cd would look for
  # xdg-user-dirs-$version/xdg-user-dirs-$version and fail).
  macro package --meson
  # Upstream also installs its own xdg-user-dirs.service (WantedBy=
  # graphical-session-pre.target, no RemainAfterExit). Ship the recipe's unit
  # over it: same anchor, plus RemainAfterExit so it runs once per login. See
  # the comments in xdg-user-dirs.service for the full reasoning, and for why
  # the autostart .desktop file that upstream installs cannot do this job under
  # GNOME (gnome-session 51 treats X-systemd-skip=true as "never autostart").
  exec "install -m 0644 \"$SRCDIR/xdg-user-dirs.service\" \"$ROOT/usr/lib/systemd/user/xdg-user-dirs.service\""
  # The preset pins the decision instead of relying on the fallback. Verified
  # against the core's systemctl: user scope currently has no "disable *"
  # default (the core's 99-default.preset is in share/presets, read only in
  # system scope; user scope reads share/presets-user, which the core does not
  # ship), so an unmatched unit is enabled anyway. The explicit rule keeps that
  # true if the core ever ships a user-scope 99-default.preset, and 60- sorts
  # before kreato-systemd-units' 81-kreato-desktop.preset, so ours is the first
  # matching rule.
  exec "install -d -m 0755 \"$ROOT/usr/lib/systemd/user-preset\""
  exec "install -m 0644 \"$SRCDIR/60-xdg-user-dirs.preset\" \"$ROOT/usr/lib/systemd/user-preset/60-xdg-user-dirs.preset\""
  # kpkg has packaged /usr/lib/systemd/user* as 0777 before (see
  # kreato-systemd-units): the core ignores every unit below a group- or
  # world-writable directory, so normalise what this package owns.
  exec "find \"$ROOT/usr/lib/systemd\" -type d -exec chmod 0755 {} + && find \"$ROOT/usr/lib/systemd\" -type f -exec chmod 0644 {} +"
}

postinstall {
  # The core's manager never applies presets on its own, and its offline
  # systemctl has no --global, so make the link `systemctl --global enable`
  # would make from the unit's [Install] section.
  # 0755 matters: the core ignores a .wants directory (and every unit in it)
  # that is group- or world-writable, and kpkg has created these directories
  # 0777 before.
  exec "umask 022 && install -d -m 0755 /etc/systemd/user /etc/systemd/user/graphical-session-pre.target.wants"
  exec "ln -sf /usr/lib/systemd/user/xdg-user-dirs.service /etc/systemd/user/graphical-session-pre.target.wants/xdg-user-dirs.service"
  # Same repair kreato-systemd-units does for the directories it owns: kpkg
  # may have created them world-writable.
  exec "chmod go-w /usr/lib/systemd /usr/lib/systemd/user /usr/lib/systemd/user-preset 2>/dev/null || true"
}
