# Kreato Linux GNOME dash favourites: only what the image ships, since the
# stock list names apps that are not installed (missing-app placeholders).
# Sorts after gnome-shell's 00_ and kreato-wallpapers' 90_ override.
[org.gnome.shell]
favorite-apps=['vivaldi-stable.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.TextEditor.desktop']
