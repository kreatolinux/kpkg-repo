name: "polkit"
version: "124"
release: "5"
description: "A toolkit for defining and handling authorizations"
sources:
 - "https://gitlab.freedesktop.org/polkit/polkit/-/archive/${version}/polkit-${version}.tar.gz"
 - "polkit-libelogind.patch"
sha256sum:
 - "72457d96a0538fd03a3ca96a6bf9b7faf82184d4d67c793eb759168e4fd49e20"
 - "a1230e22fae044aeac64987b3cd985a8904d5f4feb82c7f8388e1d03980e6730"
depends:
 - "elogind"
 - "linux-pam"
 - "glib"
 - "gobject-introspection"
 - "expat"
 - "dbus"
 - "duktape"
 - "kreato-fs-essentials"
build_depends:
 - "meson"
 - "ninja"

prepare {
 # polkit 124's meson.build reads systemd_dep outside the branch that assigns
 # it, so -Dsession_tracking=libelogind aborted meson setup.
 exec "patch -p1 < ../polkit-libelogind.patch"
}

build {
 # elogind, not systemd, provides org.freedesktop.login1 here, so track
 # sessions through libelogind.
 macro build --libdir=/usr/lib -Dsession_tracking=libelogind
}

package {
 exec "DESTDIR=\"$ROOT\" ninja -C build install"

 # Applied by kreato-sysusers in postinstall.
 exec "mkdir -p $ROOT/usr/lib/sysusers.d"
 write "$ROOT/usr/lib/sysusers.d/polkit.conf" """
# polkit daemon account.
u polkitd 27
"""
 exec "chmod 0644 $ROOT/usr/lib/sysusers.d/polkit.conf"
}

postinstall {
  # kreato-sysusers ships with kreato-fs-essentials; the environment a build
  # seeds does not have it and does not need the accounts, so this is a no-op
  # there.
  exec "if [ -x \"${ROOT:-}/usr/libexec/kreato-sysusers\" ]; then \"${ROOT:-}/usr/libexec/kreato-sysusers\" \"${ROOT:-}/usr/lib/sysusers.d/polkit.conf\"; fi"
  # The core applies presets to the units installed when it is set up; a
  # package installed later enables its own units here.
  exec "if [ -x /usr/bin/systemctl ] && [ -e /etc/jumpstart/cores/enabled/systemd ]; then /usr/bin/systemctl preset polkit.service || true; fi"
}
