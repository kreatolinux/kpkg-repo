name: "polkit"
version: "124"
release: "2"
description: "A toolkit for defining and handling authorizations"
sources:
 - "https://gitlab.freedesktop.org/polkit/polkit/-/archive/${version}/polkit-${version}.tar.gz"
sha256sum:
 - "72457d96a0538fd03a3ca96a6bf9b7faf82184d4d67c793eb759168e4fd49e20"
depends:
 - "elogind"
 - "linux-pam"
 - "glib"
 - "gobject-introspection"
 - "expat"
 - "dbus"
 - "duktape"
build_depends:
 - "meson"
 - "ninja"

build {

 if ${exec("command -v systemctl")}.exit() == 0 {
 local extraArgs = "-Dsession_tracking=libsystemd-login"
}

 macro build --libdir=/usr/lib ${extraArgs}
}

package {
 exec "DESTDIR=\"$ROOT\" ninja -C build install"
}

postinstall {
# From BLFS
 exec "groupadd -fg 27 polkitd || true"
 exec "id -u polkitd >/dev/null 2>&1 || useradd -c \"PolicyKit Daemon Owner\" -d /etc/polkit-1 -u 27 -g polkitd -s /bin/false polkitd"
}


