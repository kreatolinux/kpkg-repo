name: "mold"
version: "3.0.0"
release: "1"
description: "A Modern Linker"
sources:
  - "https://github.com/rui314/mold/archive/refs/tags/v$version.tar.gz"
sha256sum:
  - "1dee837e227b0c3f2661def602ef8ddc0b889ae5b1d28c1ddec5f29e08e5ceb5"
depends:
  - "cmake"
build_depends:
  - "gmake"

build {
  exec "mkdir build"
  cd "build"
  exec "cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=c++ -DCMAKE_INSTALL_PREFIX=/usr .."
  exec "cmake --build . -j $(nproc)"
}

package {
  exec "cmake --install ."
}

