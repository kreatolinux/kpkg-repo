name: "kpkg"
version: "8.0.0"
release: "5"
description: "kpkg, the Kreato Linux package manager"
# MIT/ISC: vendored and statically compiled in: db_connector, lowdb, nimcrypto,
# norm, regex, unicodedb (MIT), cligen (ISC).
license:
  - "GPL-3.0-or-later"
  - "MIT"
  - "ISC"
# Built from the Kreato src-2 tree; no upstream src-2 release exists, so the
# source ships here. make-tarball.sh (on the build host) regenerates it and the sum.
# Layout: kpkg-$version/{nim.cfg,SOURCE,tools/,vendor/,src-2/}; the top-level
# nim.cfg points Nim at the vendored libraries (the sandbox has no ~/.nimble).
sources:
  - "kpkg-$version.tar.gz"
sha256sum:
  - "0082d7def81865a9f1a056f402e612248c27f9ef2bd07103ec6c79c6c30cbe28"
extract: false
# libarchive is linked; openssl (-d:ssl) and sqlite are dlopen()ed at run time.
depends:
  - "libarchive"
  - "shadow"
  - "openssl"
  - "git"
  - "bubblewrap"
  - "sqlite"
build_depends:
  - "nim"

prepare {
  exec "tar -oxf kpkg-$version.tar.gz"
  cd "kpkg-$version/src-2"
}

build {
  # src-2's own build flags, via a wrapper that puts a git shim first in PATH so
  # `kpkg --version` names the src-2 revision. No -d:ver: the default "v8.0" is
  # the apiVer stamped into every package kpkg builds.
  exec "sh ../tools/build-kpkg.sh"
}

package {
  exec "install -d -m 0755 \"$ROOT/bin\" \"$ROOT/usr/share/man/man5\" \"$ROOT/usr/share/man/man8\""
  exec "install -m 0755 out/kpkg \"$ROOT/bin/kpkg\""
  exec "install -m 0644 man/kpkg*.5 \"$ROOT/usr/share/man/man5/\""
  exec "install -m 0644 man/kpkg*.8 \"$ROOT/usr/share/man/man8/\""
}
