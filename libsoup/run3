name: "libsoup"
version: "3.6.6"
release: "2"
description: "libsoup"
sources:
 - "https://download.gnome.org/sources/libsoup/${version.split('.')[0:2].join('.')}/libsoup-${version}.tar.xz"
sha256sum:
 - "51ed0ae06f9d5a40f401ff459e2e5f652f9a510b7730e1359ee66d14d4872740"
depends:
 - "glib"
 - "glib-networking"
 - "libxml2"
 - "nghttp2"
 - "sqlite"
 - "gobject-introspection"
 - "vala"
 - "libpsl"
build_depends:
 - "meson"
 - "ninja"

build {
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dvapi=enabled -Dgssapi=disabled -Dntlm=disabled -Dbrotli=disabled -Dsysprof=disabled -Ddocs=disabled -Dtests=false -Dautobahn=disabled -Dpkcs11_tests=disabled
}

package {
 macro package
}


