[Unit]
Description=PipeWire Multimedia Service
# Kreato's pipewire is built with -Dsystemd-user-service=disabled; it reads
# LISTEN_FDS itself, so socket activation still works.
Requires=pipewire.socket
After=pipewire.socket
ConditionUser=!root
ConditionFileIsExecutable=/usr/bin/pipewire

[Service]
Type=simple
ExecStart=/usr/bin/pipewire
Restart=on-failure
Slice=session.slice

[Install]
Also=pipewire.socket
WantedBy=default.target
