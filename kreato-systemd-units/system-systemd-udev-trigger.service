[Unit]
Description=Coldplug All udev Devices (eudev)
Documentation=man:udevadm(8)
DefaultDependencies=no
Wants=systemd-udevd.service
After=systemd-udevd.service
Before=sysinit.target
ConditionFileIsExecutable=/usr/bin/udevadm

[Service]
Type=oneshot
RemainAfterExit=yes
# Without the trigger /dev/dri/* stay root:root 0600 and GDM's greeter cannot
# open the DRM node.
ExecStart=/usr/bin/udevadm trigger --type=subsystems --action=add
ExecStart=/usr/bin/udevadm trigger --type=devices --action=add
ExecStart=-/usr/bin/udevadm settle --timeout=30

[Install]
WantedBy=sysinit.target
