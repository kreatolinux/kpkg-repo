name: "kreato-systemd-units"
version: "0.1.0"
release: "2"
description: "systemd units for Kreato's desktop services under jumpstart-systemd-core"
no_chkupd: true
license:
  - "GPL-3.0-or-later"
  - "MIT"
# Kreato builds dbus, elogind, eudev, polkit, accountsservice, networkmanager,
# gdm, openssh, pipewire and wireplumber without systemd integration, so none
# of them ships a unit. This package provides them (the pipewire/wireplumber
# user units follow upstream's), a drop-in that makes upower's own unit run
# under the core, and presets enabling all of it.
# For GNOME under the per-user Jumpstart manager it also ships the user bus
# (user-dbus.service: Type=forking, because Kreato's dbus cannot take a
# socket-activated listener), gnome-shell's org.gnome.Shell@.service and
# org.gnome.Shell-disable-extensions.service (gnome-shell is built with
# -Dsystemd=false, which skips installing them) and a drop-in that makes
# gnome-session-restart-dbus restart the user bus instead of stopping it. Every unit carries
# ConditionFileIsExecutable= on its daemon, so a unit whose package is absent
# is skipped, not failed; only the packages below are hard dependencies
# (upower so that its unit exists when the preset is applied).
# Sources are flat files here: kpkg stages local sources by basename, so
# "system-X" installs as usr/lib/systemd/system/X, "user-X" as
# usr/lib/systemd/user/X, "system-A.service.d_B.conf" as A.service.d/B.conf.
sources:
  - "81-kreato-desktop-user.preset"
  - "81-kreato-desktop.preset"
  - "system-NetworkManager.service"
  - "system-accounts-daemon.service"
  - "system-dbus.service"
  - "system-dev-shm.mount"
  - "system-elogind.service"
  - "system-gdm.service"
  - "system-polkit.service"
  - "system-sshd.service"
  - "system-systemd-udev-trigger.service"
  - "system-systemd-udevd.service"
  - "system-upower.service.d_10-kreato.conf"
  - "user-dbus.service"
  - "user-gnome-session-restart-dbus.service.d_10-kreato.conf"
  - "user-org.gnome.Shell-disable-extensions.service"
  - "user-org.gnome.Shell@.service"
  - "user-pipewire-pulse.service"
  - "user-pipewire-pulse.socket"
  - "user-pipewire.service"
  - "user-pipewire.socket"
  - "user-wireplumber.service"
