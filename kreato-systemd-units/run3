# The unit files here are written for the compatibility core.
depends:
 - "jumpstart-systemd-core"
  - "dbus"
  - "eudev"
  - "elogind"
  - "upower"

prepare {
  exec ":"
}

package {
  # The core ignores units below a group- or world-writable directory.
  exec "umask 022 && install -d -m 0755 \"$ROOT/usr\" \"$ROOT/usr/lib\" \"$ROOT/usr/lib/systemd\" \"$ROOT/usr/lib/systemd/system\" \"$ROOT/usr/lib/systemd/system/upower.service.d\" \"$ROOT/usr/lib/systemd/user\" \"$ROOT/usr/lib/systemd/system-preset\" \"$ROOT/usr/lib/systemd/user-preset\""
  for u in ["NetworkManager.service", "accounts-daemon.service", "dbus.service", "dev-shm.mount", "elogind.service", "gdm.service", "polkit.service", "sshd.service", "systemd-udev-trigger.service", "systemd-udevd.service"] {
    exec "install -m 0644 system-$u \"$ROOT/usr/lib/systemd/system/$u\""
  }
  for u in ["pipewire-pulse.service", "pipewire-pulse.socket", "pipewire.service", "pipewire.socket", "wireplumber.service", "dbus.service", "org.gnome.Shell@.service", "org.gnome.Shell-disable-extensions.service"] {
    exec "install -m 0644 \"user-$u\" \"$ROOT/usr/lib/systemd/user/$u\""
  }
  exec "umask 022 && install -d -m 0755 \"$ROOT/usr/lib/systemd/user/gnome-session-restart-dbus.service.d\""
  exec "install -m 0644 user-gnome-session-restart-dbus.service.d_10-kreato.conf \"$ROOT/usr/lib/systemd/user/gnome-session-restart-dbus.service.d/10-kreato.conf\""
  exec "install -m 0644 system-upower.service.d_10-kreato.conf \"$ROOT/usr/lib/systemd/system/upower.service.d/10-kreato.conf\""
  exec "install -m 0644 81-kreato-desktop.preset \"$ROOT/usr/lib/systemd/system-preset/81-kreato-desktop.preset\""
  exec "install -m 0644 81-kreato-desktop-user.preset \"$ROOT/usr/lib/systemd/user-preset/81-kreato-desktop.preset\""
  exec "find \"$ROOT/usr\" -type d -exec chmod 0755 {} + && find \"$ROOT/usr\" -type f -exec chmod 0644 {} +"
}

postinstall {
  # Repair directories kpkg may have created world-writable.
  exec "chmod go-w /usr/lib/systemd /usr/lib/systemd/system /usr/lib/systemd/user /usr/lib/systemd/system-preset /usr/lib/systemd/user-preset 2>/dev/null || true"
  # No --root: the core's --root=/ resolves to relative paths.
  for u in ["dbus.service", "elogind.service", "systemd-udevd.service", "systemd-udev-trigger.service", "dev-shm.mount", "polkit.service", "accounts-daemon.service", "upower.service", "NetworkManager.service", "gdm.service", "sshd.service"] {
    exec "umask 022; if [ -e /usr/lib/systemd/system/$u ] || [ -e /etc/systemd/system/$u ]; then /usr/bin/systemctl preset $u || echo 'kreato-systemd-units: could not preset $u'; fi"
  }
  # Offline systemctl has no --global: make the links it would make.
  exec "umask 022 && install -d -m 0755 /etc/systemd/user /etc/systemd/user/sockets.target.wants /etc/systemd/user/pipewire.service.wants"
  for u in ["pipewire.socket", "pipewire-pulse.socket", "dbus.service"] {
    exec "ln -sf /usr/lib/systemd/user/$u /etc/systemd/user/sockets.target.wants/$u"
  }
  exec "ln -sf /usr/lib/systemd/user/wireplumber.service /etc/systemd/user/pipewire.service.wants/wireplumber.service"
  exec "ln -sf /usr/lib/systemd/user/wireplumber.service /etc/systemd/user/pipewire-session-manager.service"
}
