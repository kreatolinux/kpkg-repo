[Unit]
Description=Network Manager
Documentation=man:NetworkManager(8)
# Kreato's networkmanager is built with -Dsystemdsystemunitdir=no.
# NM's helpers (dispatcher, ...) are started through D-Bus.
Wants=dbus.service network.target
After=dbus.service network-pre.target
Before=network.target
ConditionFileIsExecutable=/usr/sbin/NetworkManager

[Service]
Type=dbus
BusName=org.freedesktop.NetworkManager
ExecStart=/usr/sbin/NetworkManager --no-daemon
ExecReload=/usr/bin/dbus-send --print-reply --system --type=method_call --dest=org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager.Reload uint32:0
KillMode=process
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
Alias=dbus-org.freedesktop.NetworkManager.service
