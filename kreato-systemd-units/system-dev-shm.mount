[Unit]
Description=Shared Memory (/dev/shm)
# Nothing in the boot chain creates /dev/shm: Jumpstart's serviceHandler
# mounts proc, devtmpfs on /dev, devpts, sysfs and tmpfs /run, and
# systemd-tmpfiles-setup runs with --exclude-prefix=/dev, so a tmpfiles line
# cannot fix it. GLib, mutter and X all need it.
DefaultDependencies=no
Before=sysinit.target
ConditionPathIsMountPoint=!/dev/shm

[Mount]
What=tmpfs
Where=/dev/shm
Type=tmpfs
Options=mode=1777,nosuid,nodev

[Install]
WantedBy=sysinit.target
