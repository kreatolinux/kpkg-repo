[Unit]
Description=Shared Memory (/dev/shm)
# Nothing in the boot chain creates /dev/shm (systemd-tmpfiles-setup runs with
# --exclude-prefix=/dev); GLib, mutter and X need it.
DefaultDependencies=no
Before=sysinit.target
ConditionPathIsMountPoint=!/dev/shm

[Mount]
What=tmpfs
Where=/dev/shm
Type=tmpfs
Options=mode=1777,nosuid,nodev

[Install]
WantedBy=sysinit.target
