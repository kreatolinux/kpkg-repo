# User message bus for the jumpstart systemd core. Kreato's dbus cannot be
# socket-activated, so it binds $XDG_RUNTIME_DIR/bus itself and Type=forking
# waits for it.
[Unit]
Description=D-Bus User Message Bus
Documentation=man:dbus-daemon(1)
DefaultDependencies=no
Before=sockets.target shutdown.target
Conflicts=shutdown.target
ConditionFileIsExecutable=/usr/bin/dbus-daemon

[Service]
Type=forking
ExecStart=/usr/bin/dbus-daemon --session --address=unix:path=%t/bus --fork --nopidfile --systemd-activation --syslog-only
ExecReload=/usr/bin/dbus-send --print-reply --session --type=method_call --dest=org.freedesktop.DBus / org.freedesktop.DBus.ReloadConfig
Slice=session.slice

[Install]
WantedBy=sockets.target
