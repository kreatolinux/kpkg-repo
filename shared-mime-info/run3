name: "shared-mime-info"
version: "2.5.1"
release: "3"
description: "shared-mime-info"
sources:
 - "https://gitlab.freedesktop.org/xdg/shared-mime-info/-/archive/${version}/shared-mime-info-${version}.tar.gz"
sha256sum:
 - "ea248ea157b7fa0165f4fe282c84919fa84c3f175553642f229c8f1ab7539128"
depends:
 - "glib"
 - "libxml2"
build_depends:
 - "meson"

build {
 macro build --meson -Dbuild-spec=false
}

package {
 macro package
}

postinstall {
  # kpkg runs this hook inside the build sandbox for every dependency,
  # and the sandbox env carries only the toolchain: glib is not there,
  # so update-mime-database cannot load libglib-2.0.so.0 and the whole
  # build aborts. Skip when the tool cannot run; the mime database is
  # regenerated on any real system that has glib.
  exec "update-mime-database /usr/share/mime 2>/dev/null || true"
}


