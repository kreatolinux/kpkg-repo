name: "cairo"
version: "1.18.6"
release: "1"
description: "2D graphics library"
sources:
 - "https://cairographics.org/releases/cairo-${version}.tar.xz"
sha256sum:
 - "1c767308174337a74694da0f3ec069c271452163a1ef4540964c50c301f157d4"
depends:
 - "libpng"
 - "libx11"
 - "libxcb"
 - "libxext"
 - "libxrender"
 - "pixman"
 - "fontconfig"
 - "glib"
 - "freetype"
 - "pkgconf"
build_depends:
 - "meson"
 - "ninja"

build {
 macro build --libdir=/usr/lib -Dtests=disabled -Dspectre=disabled -Dlzo=disabled
}

package {
 macro package
}


