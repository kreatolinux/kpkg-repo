name: "pulseaudio"
version: "17.0"
release: "2"
description: "Sound system"
sources:
  - "https://www.freedesktop.org/software/pulseaudio/releases/pulseaudio-$version.tar.xz"
sha256sum:
  - "053794d6671a3e397d849e478a80b82a63cb9d8ca296bd35b73317bb5ceb87b5"
depends:
  - "libsndfile"
  - "libtool"
  - "gdbm"
  - "alsa-lib"
  - "dbus"
  - "elogind"
  - "glib"
build_depends:
  - "meson"
  - "ninja"
opt_depends:
  - "bluez: for Bluetooth support"

build {
  local bluez5 = "disabled"
  if ${exec("command -v bluetoothctl")}.exit() == 0 {
    global bluez5 = "enabled"
  }

  exec "meson setup --prefix=/usr --libdir=/usr/lib --buildtype=release -Dman=false -Ddoxygen=false -Dtests=false -Ddatabase=gdbm -Dbluez5=$bluez5 build"
  exec "ninja -C build"
}

package {
  exec "DESTDIR=\"$ROOT\" ninja -C build install"
}

