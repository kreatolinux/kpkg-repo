name: "rust"
version: "1.99.0"
release: "2"
description: "Memory-safe programming language that doesn't use garbage collection"
sources:
  - "https://static.rust-lang.org/dist/rustc-$version-src.tar.gz"
sha256sum:
  - "2035e4077b834a42ff8afd07f277ae3f06340098b86b1d2843aa234b4cfcae67"
depends:
  - "llvm"
build_depends:
  - "python"
  - "cmake"
  - "curl"

build {
  exec "./configure --prefix=/usr --llvm-config=/usr/bin/llvm-config --enable-llvm-link-shared --enable-extended --tools=cargo --disable-docs --set build.build-stage=1 --set build.install-stage=1 --set build.compiler-docs=false --set rust.llvm-bitcode-linker=false --set rust.lld=false --set rust.lto=off --set rust.debuginfo-level=0 --set rust.debuginfo-level-rustc=0 --set rust.debuginfo-level-std=0 --set rust.debuginfo-level-tools=0 --set rust.strip=true --set llvm.download-ci-llvm=false"
  exec "./x.py build --stage 1 compiler library/std src/tools/cargo"
}

package {
  exec "DESTDIR=\"$ROOT\" ./x.py install --stage 1 compiler/rustc library/std cargo"
}
