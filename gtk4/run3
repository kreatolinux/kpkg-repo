name: "gtk4"
version: "4.24.1"
release: "1"
description: "gtk4"
sources:
 - "https://download.gnome.org/sources/gtk/${version.split('.')[0:2].join('.')}/gtk-${version}.tar.xz"
sha256sum:
 - "e98abe720e16129c8c0f50761dee0a2e9ae2478055e31018f6cf977fcf6513e9"
depends:
 - "libdrm"
 - "libx11"
 - "cantarell-fonts"
 - "libxcursor"
 - "libxdamage"
 - "libxext"
 - "libxfixes"
 - "libxi"
 - "libxinerama"
 - "libxkbcommon"
 - "libxrandr"
 - "libxrender"
 - "gdk-pixbuf"
 - "libtiff"
 - "libepoxy"
 - "pango"
 - "graphene"
 - "adwaita-icon-theme"
 - "iso-codes"
 - "wayland"
 - "wayland-protocols"
build_depends:
 - "meson"
 - "ninja"
 - "gobject-introspection"

prepare {
 # No-op on 4.24: !9384 ("build: Remove objcopy resource build") dropped
 # can_use_objcopy_for_resources entirely, and the objcopy path was already
 # gated on x86_64 anyway. Kept so the step still does the right thing if the
 # variable ever comes back.
 exec "sed -i 's/can_use_objcopy_for_resources = true/can_use_objcopy_for_resources = false/g' meson.build"
}

build {
  # gdk-pixbuf resolves file types through the compiled shared MIME
  # database, and the build sandbox only carries its XML sources.
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dx11-backend=true -Dmedia-gstreamer=disabled -Dintrospection=enabled -Dvulkan=disabled -Dbuild-demos=false -Dbuild-tests=false -Dbuild-testsuite=false -Dbuild-examples=false
}

package {
 macro package
}


