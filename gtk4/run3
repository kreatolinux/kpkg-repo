name: "gtk4"
version: "4.20.4"
release: "2"
description: "gtk4"
sources:
 - "https://download.gnome.org/sources/gtk/${version.split('.')[0:2].join('.')}/gtk-${version}.tar.xz"
sha256sum:
 - "a21f825bd44afc4dd99ba4eea8ff57c8f2e51085cb402a68ed4cbb35299826a4"
depends:
 - "libx11"
 - "cantarell-fonts"
 - "libxcursor"
 - "libxdamage"
 - "libxext"
 - "libxfixes"
 - "libxi"
 - "libxinerama"
 - "libxkbcommon"
 - "libxrandr"
 - "libxrender"
 - "gdk-pixbuf"
 - "libtiff"
 - "libepoxy"
 - "pango"
 - "graphene"
 - "adwaita-icon-theme"
 - "iso-codes"
 - "wayland"
 - "wayland-protocols"
build_depends:
 - "meson"
 - "ninja"
 - "gobject-introspection"

prepare {
 exec "sed -i 's/can_use_objcopy_for_resources = true/can_use_objcopy_for_resources = false/g' meson.build"
}

build {
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dx11-backend=true -Dmedia-gstreamer=disabled -Dintrospection=enabled -Dvulkan=disabled -Dbuild-demos=false -Dbuild-tests=false -Dbuild-testsuite=false -Dbuild-examples=false
}

package {
 macro package
}


