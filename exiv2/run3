name: "exiv2"
version: "0.28.9"
release: "1"
description: "Image metadata library and tools"
sources:
 - "https://github.com/Exiv2/exiv2/archive/refs/tags/v${version}.tar.gz"
sha256sum:
 - "700b76b97695b2fab4ef8c79619c68ae57d09e0c130724791cafbd39e0eb4aef"
depends:
 - "gettext"
 - "curl"
 - "expat"
