name: "mercurial"
version: "7.2.4"
release: "2"
description: "A free, distributed source control management tool"
sources:
 - "https://www.mercurial-scm.org/release/mercurial-${version}.tar.gz"
b2sum:
 - "3ca3ee5b11948d81111e3e11c403f0d0d92ca25eea22694e3b1708a3a59969d32606a8104f56f4b7e991a414b89326e74b5f6c711cd99f85e7061cf958929218"
depends:
 - "python"
build_depends:
  - "python-setuptools"
  - "python-setuptools-scm"

build {
 exec "python setup.py build"
}

package {
 exec "python setup.py install --root=$ROOT --prefix=/usr"
}


