name: "cmake"
version: "4.4.3"
release: "2"
description: "CMake package contains a modern toolset used for generating Makefiles."
sources:
  - "https://cmake.org/files/v${version.split('.')[0:2].join('.')}/cmake-$version.tar.gz"
sha256sum:
  - "c46400618b4f1f2b43507f24fb22f3ae830c3416cf23b776e16e1d413aa892f0"
depends:
  - "expat"
  - "libuv"
  - "rhash"
  - "libarchive"
  - "libxml2"
  - "curl"
  - "jsoncpp"
build_depends:
  - "gmake"
bootstrap_depends:
  - "gmake"

build {
  exec "sed -i '19i #include <cstdint>' Utilities/cmcppdap/include/dap/network.h"
  exec "sed -i '/\"lib64\"/s/64//' Modules/GNUInstallDirs.cmake"
  if "${KPKG_BOOTSTRAP}" == "1" {
    exec "./bootstrap --prefix=/usr --mandir=/share/man --docdir=/share/doc/cmake-$version --no-system-libs -- -DCMAKE_USE_OPENSSL=OFF"
  } else {
    exec "./bootstrap --prefix=/usr --mandir=/share/man --docdir=/share/doc/cmake-$version --system-curl"
  }
  exec "make -j$(nproc)"
}

package {
  exec "make DESTDIR=$ROOT install"
}

