name: "openssh"
version: "10.6p1"
release: "7"
description: "ssh tools"
sources:
 - "https://ftp.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-${version}.tar.gz"
sha256sum:
 - "a9dc9565dffe8640f64d863cd29a32bc4a3dbdec0566a7fc44c5d6ee767d5f39"
depends:
 - "shadow"
 - "zlib"
 - "kreato-fs-essentials"
build_depends:
 - "gmake"

build {
 macro build --without-zlib-version-check
}

package {
 macro package
 # /etc/ssh/sshd_config.d holds the mutable drop-ins; the packaged config
 # stays under /usr/etc and gains an Include for that directory.
 exec "sed -i '1i Include /etc/ssh/sshd_config.d/*.conf' $ROOT/usr/etc/sshd_config"
 exec "install -d -m 0755 $ROOT/etc/ssh/sshd_config.d"
 exec "mkdir -p $ROOT/usr/lib/sysusers.d"
 write "$ROOT/usr/lib/sysusers.d/openssh.conf" """
# sshd privilege-separation account.
u sshd 74
"""
 exec "chmod 0644 $ROOT/usr/lib/sysusers.d/openssh.conf"
 # Native jumpstart unit; enabling it is left to the image.
 exec "mkdir -p $ROOT/etc/jumpstart"
 write "$ROOT/etc/jumpstart/sshd.kg" """
name: "sshd"
description: "OpenSSH server daemon."
type: "simple"
restart: "always"

service {
  exec_pre "/usr/bin/ssh-keygen -A"
  exec "/usr/sbin/sshd -D"
}
"""
 exec "chmod 0644 $ROOT/etc/jumpstart/sshd.kg"
}

postinstall {
 # sshd drops privileges to this account.
  # kreato-sysusers ships with kreato-fs-essentials; the environment a build
  # seeds does not have it and does not need the accounts, so this is a no-op
  # there.
  exec "if [ -x \"${ROOT:-}/usr/libexec/kreato-sysusers\" ]; then \"${ROOT:-}/usr/libexec/kreato-sysusers\" \"${ROOT:-}/usr/lib/sysusers.d/openssh.conf\"; fi"
}
