sources:
 - "https://gitlab.gnome.org/GNOME/librest/-/archive/${version}/librest-${version}.tar.gz"
sha256sum:
 - "adef677ecdbe16f94906f59f07519938a82a207b8c019e37f2d68463f94a464d"
depends:
 - "gobject-introspection"
 - "json-glib"
