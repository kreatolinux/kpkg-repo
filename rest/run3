name: "rest"
version: "0.10.2"
release: "3"
description: "RESTful web API query library"
sources:
 - "https://download.gnome.org/sources/librest/${version.split('.')[0:2].join('.')}/librest-${version}.tar.xz"
sha256sum:
 - "7b6cb912bb3a22cfa7dcf005925dcb62883024db0c09099486e7d6851185c9b8"
depends:
 - "gobject-introspection"
 - "json-glib"
 - "libsoup"
 - "ca-certificates"
build_depends:
 - "meson"

build {
 macro build --libdir=/usr/lib --wrap-mode=nodownload -Dgtk_doc=false -Dexamples=false -Dtests=false
}

package {
 macro package
}
