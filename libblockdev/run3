name: "libblockdev"
version: "3.5.0"
release: "1"
description: "libblockdev"
sources:
 - "https://github.com/storaged-project/libblockdev/releases/download/${version}/libblockdev-${version}.tar.gz"
sha256sum:
 - "bccd30e6b5d11504de60d9889ff6a2a25b07a4ec8f04070f2387e168301b3e3a"
depends:
 - "glib"
 - "keyutils"
 - "cryptsetup"
 - "lvm2"
 - "e2fsprogs"
 - "eudev"
 - "util-linux"
 - "libbytesize"
 - "gobject-introspection"
 - "libnvme"
 - "kmod"
 - "libyaml"
 - "json-glib"
 - "libatasmart"
build_depends:
 - "gmake"

prepare {
 exec "sed -i 's|temp_file=$(mktemp --tmpdir XXXXX.c)|temp_file=$(mktemp /tmp/tmp.XXXXXX); mv $temp_file ${temp_file}.c; temp_file=${temp_file}.c|g' configure"
}

build {
# from BLFS
 macro build --sysconfdir=/etc --with-python3 --without-escrow --without-gtk-doc --without-lvm_dbus --without-nvdimm --without-tools --without-smartmontools --disable-tests
}

package {
 macro package
}


