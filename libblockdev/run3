name: "libblockdev"
version: "3.0.4"
release: "4"
description: "libblockdev"
sources:
 - "https://github.com/storaged-project/libblockdev/releases/download/${version}-1/libblockdev-${version}.tar.gz"
sha256sum:
 - "49841ff92db0ab032931e6f2b5eab63e5969b0ddc14b067b60e46a6eb6c60e47"
depends:
 - "glib"
 - "keyutils"
 - "cryptsetup"
 - "lvm2"
 - "e2fsprogs"
 - "eudev"
 - "util-linux"
 - "libbytesize"
 - "gobject-introspection"
 - "libnvme"
build_depends:
 - "gmake"

prepare {
 exec "sed -i 's|temp_file=$(mktemp --tmpdir XXXXX.c)|temp_file=$(mktemp /tmp/tmp.XXXXXX); mv $temp_file ${temp_file}.c; temp_file=${temp_file}.c|g' configure"
}

build {
# from BLFS
 macro build --sysconfdir=/etc --with-python3 --without-escrow --without-gtk-doc --without-lvm_dbus --without-nvdimm --without-tools
}

package {
 macro package
}


