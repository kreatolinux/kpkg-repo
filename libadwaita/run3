name: "libadwaita"
version: "1.8.8"
release: "2"
description: "GNOME ui stuff"
sources:
 - "https://download.gnome.org/sources/libadwaita/${version.split('.')[0:2].join('.')}/libadwaita-${version}.tar.xz"
sha256sum:
 - "9e64939959a071cb660090c0e1b380c51ca29e3cfb57f3f23ea42a9922eb6f41"
depends:
 - "gtk4"
 - "appstream"
build_depends:
 - "meson"
 - "ninja"
 - "vala"
 - "sassc"

build {
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Ddocumentation=false -Dintrospection=enabled -Dvapi=true -Dtests=false -Dexamples=false
}

package {
 macro package
}


