name: "libadwaita"
version: "1.8.0"
release: "1"
description: "GNOME ui stuff"
sources:
 - "https://download.gnome.org/sources/libadwaita/${version.split('.')[0:2].join('.')}/libadwaita-${version}.tar.xz"
sha256sum:
 - "2836d2c0c0f46dcdb52f94019477f537810283c710802d8e6671efdebe2637c9"
depends:
 - "libtool"
 - "gtk4"
 - "appstream"
build_depends:
 - "meson"
 - "ninja"
 - "vala"
 - "sassc"

build {
  # gdk-pixbuf resolves file types through the compiled shared MIME
  # database, and the build sandbox only carries its XML sources.
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Ddocumentation=false -Dintrospection=enabled -Dvapi=true -Dtests=false -Dexamples=false
}

package {
 macro package
}


