name: "accountsservice"
version: "26.27.3"
release: "1"
description: "D-Bus interface for user account query and manipulation"
sources:
 - "https://gitlab.freedesktop.org/accountsservice/accountsservice/-/archive/${version}/accountsservice-${version}.tar.gz"
sha256sum:
 - "11de07bcd499c2277f78a6fc830d1437654f3397cc7bbed19c28b3818435ba38"
depends:
 - "gobject-introspection"
 - "polkit"
 - "elogind"
 - "json-c"
 - "libxcrypt"
 - "dbus"
build_depends:
 - "meson"
 - "ninja"
 - "vala"
 - "gettext"

# 26.x is meson-only and still supports elogind through -Delogind=true (it then
# requires libelogind >= 229.4; elogind ships libelogind.pc and libsystemd.pc).
# The systemd unit is not installed here: kreato-systemd-units ships
# accounts-daemon.service for the jumpstart compatibility core.
#
# The options are written literally on the macro line on purpose: passing them
# through a local variable after another -D value used to glue the last value
# and the first extra flag together ("wheel-Delogind=true"), which silently
# produced a bogus ADMIN_GROUP and dropped the elogind dependency.
#
# -Dtests=false replaces the old "sed out subdir('tests')" hack; the tests need
# the mocklibc wrap, which --wrap-mode=nodownload would refuse to fetch.
build {
 macro build --libdir=/usr/lib -Dadmin_group=wheel -Delogind=true -Dsystemdsystemunitdir=no -Dtests=false --wrap-mode=nodownload
}

package {
 macro package
 exec "mkdir -p $ROOT/etc/polkit-1/rules.d"
 write "$ROOT/etc/polkit-1/rules.d/40-wheel.rules" """
polkit.addAdminRule(function(action, subject) {
 return ["unix-group:wheel"];
});
"""
}
