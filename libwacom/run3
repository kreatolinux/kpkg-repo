name: "libwacom"
version: "2.20.0"
release: "2"
description: "Library for Wacom tablets"
sources:
 - "https://github.com/linuxwacom/libwacom/releases/download/libwacom-${version}/libwacom-${version}.tar.xz"
sha256sum:
 - "370b45b5e05a91960df0aeb9c9481ae05846aab92ab2d4ec66945a0da4216888"
depends:
 - "libgudev"
 - "libxml2"
 - "libevdev"
build_depends:
 - "meson"

build {
 macro build -Dlibdir=lib -Dtests=disabled -Ddocumentation=disabled --wrap-mode=nodownload
}

package {
 macro package -Dlibdir=lib
}


