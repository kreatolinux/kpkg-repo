name: "mpfr"
version: "4.2.2"
release: "1"
description: "GNU mpfr"
sources:
 - "https://ftp.gnu.org/gnu/mpfr/mpfr-${version}.tar.xz"
sha256sum:
 - "b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01"
depends:
 - "gmp"
build_depends:
 - "gmake"

build {
 local extraArgs=""
 if "$KPKG_ARCH" != "${exec('uname -m').output()}" {
 global extraArgs="--with-sysroot=/usr/$KPKG_TARGET"
}

 macro build ${extraArgs}
}

package {
 macro package
 exec "rm -rf $ROOT/usr/share/info/dir"
}


