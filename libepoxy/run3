name: "libepoxy"
version: "1.5.10"
release: "3"
description: "Epoxy is a library for handling OpenGL function pointer management for you."
sources:
 - "https://github.com/anholt/libepoxy/archive/refs/tags/${version}.tar.gz"
sha256sum:
 - "a7ced37f4102b745ac86d6a70a9da399cc139ff168ba6b8002b4d8d43c900c15"
depends:
 - "libx11"
 - "libglvnd"
 - "mesa"
build_depends:
 - "meson"
 - "ninja"

build {
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dx11=true -Dtests=false
}

package {
 macro package
}


