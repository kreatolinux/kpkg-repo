name: "nss"
version: "3.129"
release: "4"
description: "network stuff"
sources:
  - "https://archive.mozilla.org/pub/security/nss/releases/NSS_3_129_RTM/src/nss-$version.tar.gz"
  - "bundle.sh"
  - "certdata2pem.py"
sha256sum:
  - "38baa3b0a18a3f674843473b549753c96419a0151abd1e7a9b214ce0493d0785"
  - "SKIP"
  - "SKIP"
depends:
  - "nspr"
  - "sqlite"
  - "p11-kit"
  - "zlib"
build_depends:
  - "python"
  - "gmake"
  - "nspr"
depends_ca_certificates_mozilla:
  - "ca-certificates-utils"

prepare {
  exec "mkdir -p certs"
  cd "certs"
  for i in ["certdata.txt", "nssckbi.h"] {
    exec "ln -srf ../nss/lib/ckfw/builtins/$i $i"
  }
  cd ".."
}

build {
  cd "certs"

  # Scripts from Arch Linux: https://gitlab.archlinux.org/archlinux/packaging/packages/nss/-/tree/3.98-1?ref_type=tags
  exec "python ../../certdata2pem.py || exit 1"

  cd ".."
  exec "sh ../bundle.sh || exit 1"

  cd "nss"
  # NSS builds 32-bit by default unless USE_64 is set; both supported
  # architectures are 64-bit
  local arch = "${exec("uname -m").output()}"
  if "$arch" == "x86_64" || "$arch" == "aarch64" {
    env USE_64="1"
  } else {
    env USE_64="0"
  }

  # Taken from BLFS
  exec "make -j$(nproc) BUILD_OPT=1                   NSPR_INCLUDE_DIR=/usr/include/nspr   USE_SYSTEM_ZLIB=1                    ZLIB_LIBS=-lz                        NSS_ENABLE_WERROR=0                  NSS_USE_SYSTEM_SQLITE=1              USE_64=$USE_64"
}

package {
  cd ".."
  exec "mkdir -p \"$ROOT/usr/lib/pkgconfig\" \"$ROOT/usr/bin\" \"$ROOT/usr/include/nss\""
  exec "sed nss/pkg/pkg-config/nss.pc.in -e \"s,%prefix%,/usr,g\" -e \"s,%exec_prefix%,/usr,g\" -e \"s,%libdir%,/usr/lib,g\" -e \"s,%includedir%,/usr/include/nss,g\" -e \"s,%NSPR_VERSION%,4.38.2,g\" -e \"s,%NSS_VERSION%,$version,g\" | install -Dm644 /dev/stdin \"$ROOT/usr/lib/pkgconfig/nss.pc\""
  exec "ln -sf nss.pc \"$ROOT/usr/lib/pkgconfig/mozilla-nss.pc\""
  exec "install -Dt \"$ROOT/usr/lib\" dist/Linux*.OBJ/lib/*.so"
  exec "sed nss/pkg/pkg-config/nss-config.in -e \"s,@prefix@,/usr,g\" -e \"s,@exec_prefix@,/usr,g\" -e \"s,@libdir@,/usr/lib,g\" -e \"s,@includedir@,/usr/include/nss,g\" -e \"s,@MOD_MAJOR_VERSION@,3,g\" -e \"s,@MOD_MINOR_VERSION@,129,g\" -e \"s,@MOD_PATCH_VERSION@,0,g\" | install -D /dev/stdin \"$ROOT/usr/bin/nss-config\""
  exec "install -Dt \"$ROOT/usr/bin\" dist/Linux*.OBJ/bin/certutil dist/Linux*.OBJ/bin/cmsutil dist/Linux*.OBJ/bin/crlutil dist/Linux*.OBJ/bin/modutil dist/Linux*.OBJ/bin/pk12util dist/Linux*.OBJ/bin/shlibsign dist/Linux*.OBJ/bin/signtool dist/Linux*.OBJ/bin/signver dist/Linux*.OBJ/bin/ssltap dist/Linux*.OBJ/bin/symkeyutil"
  exec "install -Dt \"$ROOT/usr/include/nss\" -m644 dist/public/nss/*.h"
  exec "ln -sf pkcs11/p11-kit-trust.so \"$ROOT/usr/lib/p11-kit-trust.so\""
  exec "ln -sf p11-kit-trust.so \"$ROOT/usr/lib/libnssckbi.so\""
}

package_ca_certificates_mozilla {
  cd "-"
  exec "install -Dm644 ca-bundle.trust.p11-kit \"$ROOT/usr/share/ca-certificates/trust-source/mozilla.trust.p11-kit\""
}

