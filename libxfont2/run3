name: "libxfont2"
version: "2.0.7"
release: "2"
description: "X11 font rasterisation library"
sources:
 - "https://www.x.org/releases/individual/lib/libXfont2-${version}.tar.xz"
sha256sum:
 - "8b7b82fdeba48769b69433e8e3fbb984a5f6bf368b0d5f47abeec49de3e58efb"
depends:
 - "libfontenc"
 - "freetype"
 - "xorgproto"
 - "libpng"
 - "bzip2"
build_depends:
 - "xtrans"
 - "gmake"

build {
 exec "LIBS=\"-lpng16 -lbz2\" ./configure --prefix=/usr --sysconfdir=/etc --disable-static"
 exec "make -j${exec("nproc").output()}"
}

package {
 macro package
}


