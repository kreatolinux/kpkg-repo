name: "libxfont2"
version: "2.0.9"
release: "2"
description: "X11 font rasterisation library"
sources:
 - "https://www.x.org/releases/individual/lib/libXfont2-${version}.tar.xz"
sha256sum:
 - "f042a370666815e7b941e9b7019024755bd1c6c2954afbfa515af378251799e2"
depends:
 - "libfontenc"
 - "freetype"
 - "xorgproto"
 - "libpng"
 - "bzip2"
build_depends:
 - "xtrans"
 - "gmake"

build {
 exec "LIBS=\"-lpng16 -lbz2\" ./configure --prefix=/usr --sysconfdir=/etc --disable-static"
 exec "make -j${exec("nproc").output()}"
}

package {
 macro package
}


