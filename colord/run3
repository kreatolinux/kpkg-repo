name: "colord"
version: "1.4.8"
release: "6"
description: "A system service that makes it easy to manage, install and generate color profiles"
sources:
 - "https://www.freedesktop.org/software/colord/releases/colord-${version}.tar.xz"
sha256sum:
 - "21500bd68975312a7f0f3ce6019d9f75f42aacaa75ca7115ec720b5445406896"
depends:
 - "glib"
 - "eudev"
 - "libgusb"
 - "lcms2"
 - "elogind"
 - "libgudev"
 - "polkit"
 - "dbus"
 - "sqlite"
 - "kreato-fs-essentials"
build_depends:
 - "meson"
 - "vala"
 - "gobject-introspection"

build {
 local systemd = "false"
 macro build -Dlibdir=lib -Dsystemd=$systemd -Dbash_completion=false -Dtests=false -Dinstalled_tests=false -Ddocs=false -Dman=false --wrap-mode=nodownload
}

package {
 macro package -Dlibdir=lib

 exec "mkdir -p $ROOT/usr/lib/sysusers.d"
 write "$ROOT/usr/lib/sysusers.d/colord.conf" """
# colord daemon account; the group has the same id.
u colord 122
g colord 122
"""
 exec "chmod 0644 $ROOT/usr/lib/sysusers.d/colord.conf"
}

postinstall {
 # The account the daemon runs as; the package ships it.
  # kreato-sysusers ships with kreato-fs-essentials; the environment a build
  # seeds does not have it and does not need the accounts, so this is a no-op
  # there.
  exec "if [ -x \"${ROOT:-}/usr/libexec/kreato-sysusers\" ]; then \"${ROOT:-}/usr/libexec/kreato-sysusers\" \"${ROOT:-}/usr/lib/sysusers.d/colord.conf\"; fi"
}


