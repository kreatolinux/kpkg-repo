name: "patch"
version: "2.8"
release: "1"
description: "GNU patch"
sources:
  - "https://ftp.gnu.org/gnu/patch/patch-$version.tar.gz"
sha256sum:
  - "308a4983ff324521b9b21310bfc2398ca861798f02307c79eb99bb0e0d2bf980"
build_depends:
  - "gmake"

build {
  exec "mkdir -v build"
  cd "build"
  macro build --configure=.. --disable-nls --enable-shared --disable-werror --enable-64-bit-bfd 
  exec "make"
}

package {
  exec "make DESTDIR=$ROOT install -j1"
}

