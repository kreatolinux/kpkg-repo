name: "crun"
version: "1.30.1"
release: "1"
description: "A fast and lightweight fully featured OCI runtime and C library for running containers"
sources:
 - "https://github.com/containers/crun/releases/download/${version}/crun-${version}.tar.gz"
sha256sum:
 - "99d036d95113552b6df66c7c879432835504bf0e525fc0372745071df129527b"
depends:
 - "libseccomp"
 - "libcap"
 - "yajl"
 - "json-c"
build_depends:
 - "gmake"
 - "json-c"

build {
 macro build --disable-systemd 
}

package {
 macro package --configure
}

