name: "booster"
version: "0.13"
release: "4"
description: "fast and secure initramfs generator"
sources:
 - "https://github.com/anatol/booster/archive/refs/tags/${version}.tar.gz"
sha256sum:
 - "5d6c2b56758380441a46e38f7f760eb1ffbe3008498d68676cd67458816ef5fe"
build_depends:
 - "go"

build {
 cd "init"
 exec "go build"
 cd "../generator"
 # Booster resolves libraries against a hardcoded directory list
 # (/usr/lib, /lib, /usr/lib64, /usr/lib/x86_64-linux-gnu) and never reads
 # /etc/ld.so.cache, so ldconfig cannot help it. This distribution installs
 # its runtime libraries in /lib64, which is not on that list, and image
 # generation died with "unable to find path to library libresolv.so.2".
 # Add /lib64 to the search path.
 exec "sed -i 's|\"/usr/lib\", \"/lib\", \"/usr/lib64\"|\"/usr/lib\", \"/lib\", \"/lib64\", \"/usr/lib64\"|' image.go"
 exec "go build"
}

package {
 cd "$SRCDIR"
# Taken from https://github.com/anatol/booster/blob/master/packaging/arch/PKGBUILD
 exec "env install -Dp -m755 generator/generator \"$ROOT/usr/bin/booster\""
 exec "env install -Dp -m755 init/init \"$ROOT/usr/lib/booster/init\""
 # The generator always opens /etc/booster.yaml, even with --universal, so the
 # file must exist. The Arch package creates it empty for the same reason;
 # without it `booster build` fails with
 # "open /etc/booster.yaml: no such file or directory".
 exec "mkdir -p \"$ROOT/etc\" && touch \"$ROOT/etc/booster.yaml\""
}


