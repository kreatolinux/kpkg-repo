# Kreato Linux default wallpaper. Sorts after 00_org.gnome.shell's override, so
# it wins.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/kreato/devin-wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/kreato/devin-wallpaper.png'
picture-options='zoom'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/kreato/devin-wallpaper.png'
picture-options='zoom'
