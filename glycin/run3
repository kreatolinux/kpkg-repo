name: "glycin"
version: "2.2.3"
release: "2"
description: "Sandboxed image decoding library"
sources:
 - "https://download.gnome.org/sources/glycin/${version.split('.')[0:2].join('.')}/glycin-${version}.tar.xz"
sha256sum:
 - "a767776442fce1fea7bda0178b4c443d241c33ac72e0ef83c6e06caeaaa7d9fa"
depends:
 - "libtool"
 - "glib"
 - "gtk4"
 - "fontconfig"
 - "lcms2"
 - "libseccomp"
build_depends:
 - "meson"
 - "ninja"
 - "rust"
 - "python"
 - "pkgconf"

build {
  # gdk-pixbuf resolves file types through the compiled shared MIME
  # database, and the build sandbox only carries its XML sources.
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"
 macro build --libdir=/usr/lib --wrap-mode=nodownload -Dglycin-loaders=false -Dglycin-thumbnailer=false -Dlibglycin=true -Dlibglycin-gtk4=true -Dintrospection=false -Dvapi=false -Dtests=false -Dlto=false
}

package {
 macro package
}
