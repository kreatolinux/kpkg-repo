name: "libinput"
version: "1.32.0"
release: "3"
description: "Library that handles input devices"
sources:
  - "https://gitlab.freedesktop.org/libinput/libinput/-/archive/$version/libinput-$version.tar.gz"
sha256sum:
  - "7dd6c1ca964c86eb6810ccd6639cda634e68bdca43bf3afec39e94e942fac8d4"
depends:
  - "libevdev"
  - "mtdev"
  - "eudev"
build_depends:
  - "meson"

build {
  exec "mkdir build"
  cd "build"
  exec "meson --prefix=/usr --libdir=lib --wrap-mode=nodownload --buildtype=release    -Ddebug-gui=false      -Dtests=false          -Dlibwacom=false -Dlua-plugins=disabled -Ddocumentation=false -Dinstall-tests=false       .."
  exec "ninja"
}

package {
  exec "DESTDIR=\"$ROOT\" ninja install"
}

