name: "gdk-pixbuf"
version: "2.44.8"
release: "5"
description: "GdkPixbuf is a library that loads image data in various formats and stores it as linear buffers in memory"
sources:
 - "https://gitlab.gnome.org/GNOME/gdk-pixbuf/-/archive/${version}/gdk-pixbuf-${version}.tar.gz"
sha256sum:
 - "115046cd8f84b703da9d20f1527a8d21685c17090eae0afb6bf25ca1ccd4e430"
depends:
 - "glib"
 - "libpng"
 - "libjpeg-turbo"
 - "libtiff"
 - "shared-mime-info"
build_depends:
 - "meson"
 - "gobject-introspection"
opt_depends:
 - "webp-pixbuf-loader: For webp support (runtime)"

build {
 env XDG_DATA_DIRS="/usr/local/share:/usr/share"
 macro build --libdir=/usr/lib -Dman=false -Dgtk_doc=false -Dtests=false -Dinstalled_tests=false --wrap-mode=nofallback -Dbuiltin_loaders=all
}

package {
 macro package
}

postinstall {
 exec "mkdir -p /usr/lib/gdk-pixbuf-2.0/2.10.0"
 exec "gdk-pixbuf-query-loaders --update-cache"
}


