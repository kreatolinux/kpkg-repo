name: "dbus"
version: "1.16.2"
release: "7"
description: "Message bus system"
sources:
 - "https://dbus.freedesktop.org/releases/dbus/dbus-${version}.tar.xz"
sha256sum:
 - "0ba2a1a4b16afe7bceb2c07e9ce99a8c2c3508e5dec290dbb643384bd6beb7e2"
depends:
 - "expat"
build_depends:
 - "meson"
 - "pkgconf"

build {
 local extraArgs = "-Dsystemd=disabled"
 if ${exec("command -v systemctl")}.exit() == 0 {
 global extraArgs = "-Dsystemd=enabled"
}

 macro build --meson ${extraArgs} -Ddefault_library=shared -Druntime_dir=/run --sysconfdir=/etc -Duser_session=true
}

package {
 macro package --meson
}


