name: "dbus"
version: "1.16.2"
release: "11"
description: "Message bus system"
sources:
 - "https://dbus.freedesktop.org/releases/dbus/dbus-${version}.tar.xz"
sha256sum:
 - "0ba2a1a4b16afe7bceb2c07e9ce99a8c2c3508e5dec290dbb643384bd6beb7e2"
depends:
 - "expat"
 - "kreato-fs-essentials"
build_depends:
 - "meson"
 - "pkgconf"

build {
 # Deterministic: the user bus unit comes from kreato-systemd-units, which
 # works under the compatibility core. Building with -Dsystemd=enabled
 # depending on whether the build host happens to have systemctl would ship a
 # different dbus per host and collide with that unit.
 local extraArgs = "-Dsystemd=disabled"
 global extraArgs = ""

 macro build --meson ${extraArgs} -Druntime_dir=/run --sysconfdir=/etc -Duser_session=true --libdir=/usr/lib -Dmodular_tests=disabled
}

package {
 macro package --meson

 # dbus-daemon-launch-helper must be setuid root and owned by the messagebus
 # group, or system-bus service activation fails. meson installs it 0755.
 exec "chown 0:18 $ROOT/usr/libexec/dbus-daemon-launch-helper"
 exec "chmod 4754 $ROOT/usr/libexec/dbus-daemon-launch-helper"

 # Applied by kreato-sysusers in postinstall.
 exec "mkdir -p $ROOT/usr/lib/sysusers.d"
 write "$ROOT/usr/lib/sysusers.d/dbus.conf" """
# dbus system bus account.
u messagebus 18
"""
 exec "chmod 0644 $ROOT/usr/lib/sysusers.d/dbus.conf"
}

postinstall {
  # The core applies presets to the units installed when it is set up; a
  # package installed later enables its own units here.
  exec "if [ -x /usr/bin/systemctl ] && [ -e /etc/jumpstart/cores/enabled/systemd ]; then /usr/bin/systemctl preset dbus.service || true; fi"
}

postinstall {
  # kreato-sysusers ships with kreato-fs-essentials; the environment a build
  # seeds does not have it and does not need the accounts, so this is a no-op
  # there.
  exec "if [ -x \"${ROOT:-}/usr/libexec/kreato-sysusers\" ]; then \"${ROOT:-}/usr/libexec/kreato-sysusers\" \"${ROOT:-}/usr/lib/sysusers.d/dbus.conf\"; fi"
 # gid 18 is messagebus; package() already sets these, restore them if an
 # install dropped the setuid bit.
 exec "chown 0:18 $ROOT/usr/libexec/dbus-daemon-launch-helper"
 exec "chmod 4754 $ROOT/usr/libexec/dbus-daemon-launch-helper"
}
