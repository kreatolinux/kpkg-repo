name: "dbus"
version: "1.16.2"
release: "6"
description: "Message bus system"
sources:
 - "https://dbus.freedesktop.org/releases/dbus/dbus-${version}.tar.xz"
sha256sum:
 - "0ba2a1a4b16afe7bceb2c07e9ce99a8c2c3508e5dec290dbb643384bd6beb7e2"
depends:
 - "expat"
build_depends:
 - "python-setuptools"
 - "gmake"

build {
 local extraArgs = ""
 if ${exec("command -v systemctl")}.exit() == 0 {
 global extraArgs = "--enable-systemd"
}

 macro build ${extraArgs} --configure --disable-static --runstatedir=/run --sysconfdir=/etc --enable-user-session
}

package {
 macro package
}


