name: "util-linux"
version: "2.41.3"
release: "2"
description: "Linux Utilities"
sources:
 - "https://mirrors.edge.kernel.org/pub/linux/utils/util-linux/v2.41/util-linux-${version}.tar.xz"
sha256sum:
 - "3330d873f0fceb5560b89a7dc14e4f3288bbd880e96903ed9b50ec2b5799e58b"
build_depends:
 - "gmake"

build {
 macro build --configure --disable-makeinstall-tty-setgid
}

package {
 exec "make DESTDIR=$ROOT install"
}

postinstall {
 exec "getent group tty >/dev/null || addgroup tty"
 exec "[ ! -e /usr/bin/wall ] || { chgrp tty /usr/bin/wall && chmod g+s /usr/bin/wall; }"
 exec "[ ! -e /usr/bin/write ] || { chgrp tty /usr/bin/write && chmod g+s /usr/bin/write; }"
}


