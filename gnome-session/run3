name: "gnome-session"
version: "51.0"
release: "6"
description: "The GNOME session manager"
sources:
 - "https://gitlab.gnome.org/GNOME/gnome-session/-/archive/${version}/gnome-session-${version}.tar.gz"
sha256sum:
 - "e4910848a74bc569619ec24261db9e33cdddbb4845adb0e1009fbddeb1edd524"
depends:
 - "elogind"
 - "xtrans"
 - "libsm"
 - "libx11"
 - "libxcomposite"
 - "libice"
 - "libglvnd"
 - "gnome-desktop"
 - "json-glib"
 - "mesa"
 - "upower"
build_depends:
 - "meson"

build {
 # Stock gnome-session (systemd session management): the leader's
 # gnome-session-init-worker starts gnome-session@<session>.target through
 # org.freedesktop.systemd1 on the session bus, which the per-user Jumpstart
 # manager provides (jumpstart-systemd-core, dbus/sd1api.nim). The former
 # null-backend patch and shell init worker are gone; logind comes from
 # elogind (gsm-systemd.c only talks to org.freedesktop.login1).
 # Credits to https://www.linuxfromscratch.org/blfs/view/svn/gnome/gnome-session.html
 # The unit directory is explicit: elogind provides libsystemd.pc but no
 # systemd.pc to take it from.
 macro build -Dsystemduserunitdir=/usr/lib/systemd/user --libdir=/usr/lib --wrap-mode=nodownload -Ddocbook=false -Dman=false
}

package {
 macro package
}
