name: "gnome-session"
version: "51.0"
release: "7"
description: "The GNOME session manager"
sources:
 - "https://gitlab.gnome.org/GNOME/gnome-session/-/archive/${version}/gnome-session-${version}.tar.gz"
sha256sum:
 - "e4910848a74bc569619ec24261db9e33cdddbb4845adb0e1009fbddeb1edd524"
depends:
 - "jumpstart"
 - "jumpstart-systemd-core"
 # The session leader starts gnome-session@<session>.target over
 # org.freedesktop.systemd1, which the compatibility core provides.
 - "elogind"
 - "xtrans"
 - "libsm"
 - "libx11"
 - "libxcomposite"
 - "libice"
 - "libglvnd"
 - "gnome-desktop"
 - "json-glib"
 - "mesa"
 - "upower"
build_depends:
 - "meson"

build {
 # Stock gnome-session: the leader's init worker starts
 # gnome-session@<session>.target over org.freedesktop.systemd1 on the session
 # bus, which the per-user Jumpstart manager provides. logind comes from elogind.
 # Credits to https://www.linuxfromscratch.org/blfs/view/svn/gnome/gnome-session.html
 # The unit directory is explicit: elogind ships libsystemd.pc, not systemd.pc.
 macro build -Dsystemduserunitdir=/usr/lib/systemd/user --libdir=/usr/lib --wrap-mode=nodownload -Ddocbook=false -Dman=false
}

package {
 macro package
}
