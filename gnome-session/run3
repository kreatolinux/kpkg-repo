name: "gnome-session"
version: "51.0"
release: "4"
description: "The GNOME session manager"
sources:
 - "https://gitlab.gnome.org/GNOME/gnome-session/-/archive/${version}/gnome-session-${version}.tar.gz"
sha256sum:
 - "e4910848a74bc569619ec24261db9e33cdddbb4845adb0e1009fbddeb1edd524"
depends:
 - "elogind"
 - "xtrans"
 - "libsm"
 - "libx11"
 - "libxcomposite"
 - "libice"
 - "libglvnd"
 - "gnome-desktop"
 - "json-glib"
 - "mesa"
 - "upower"
build_depends:
 - "meson"

build {

 if ${exec("command -v systemctl")}.exit() != 0 {
# Credits to https://www.linuxfromscratch.org/blfs/view/svn/gnome/gnome-session.html
 local extraArgs = "-Dsystemduserunitdir=/usr/lib/systemd/user"
}

 macro build ${extraArgs} --libdir=/usr/lib --wrap-mode=nodownload -Ddocbook=false -Dman=false
}

package {
 macro package
}


