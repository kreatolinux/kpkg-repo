name: "gnome-session"
version: "51.0"
release: "5"
description: "The GNOME session manager"
sources:
 - "https://gitlab.gnome.org/GNOME/gnome-session/-/archive/${version}/gnome-session-${version}.tar.gz"
sha256sum:
 - "e4910848a74bc569619ec24261db9e33cdddbb4845adb0e1009fbddeb1edd524"
depends:
 - "elogind"
 - "xtrans"
 - "libsm"
 - "libx11"
 - "libxcomposite"
 - "libice"
 - "libglvnd"
 - "gnome-desktop"
 - "json-glib"
 - "mesa"
 - "upower"
build_depends:
 - "meson"

build {
 # elogind provides logind but not systemd's D-Bus manager API. Without this
 # patch gsm_systemd_new() only checks /run/systemd/seats/ (which elogind
 # creates), selects the systemd backend, and every unit operation fails.
 exec "patch -p1 < ../gnome-session-null-backend.patch"

 if ${exec("command -v systemctl")}.exit() != 0 {
# Credits to https://www.linuxfromscratch.org/blfs/view/svn/gnome/gnome-session.html
 local extraArgs = "-Dsystemduserunitdir=/usr/lib/systemd/user"
}

 macro build ${extraArgs} --libdir=/usr/lib --wrap-mode=nodownload -Ddocbook=false -Dman=false
}

package {
 macro package

 # Upstream factors init-system-specific startup into gnome-session-init-worker
 # so GNOME can work with inits other than systemd (see leader-main.c). The
 # stock helper starts gnome-session@<session>.target over org.freedesktop.systemd1
 # and calls g_error() -- which aborts -- when that name is absent. Replace it
 # with a shim that starts gnome-session-service directly and then signals
 # org.gnome.SessionManager.Initialized() to advance past INITIALIZATION.
 exec "install -Dm755 ../gnome-session-init-worker.sh $ROOT/usr/libexec/gnome-session-init-worker"
}
