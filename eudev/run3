name: "eudev"
version: "3.3.0"
release: "1"
description: "Fork of systemd with the aim of making udev init-independent"
sources:
 - "https://github.com/eudev-project/eudev/releases/download/v${version}/eudev-${version}.tar.gz"
sha256sum:
 - "8fba6e4f49ea4b1938828a3c2e7cc48874816c68621386e527076b6477f5d6ef"
depends:
 - "gperf"
 - "kmod"
build_depends:
 - "gmake"
replaces:
 - "systemd"

build {
 macro build
}

package {
 macro package
 exec "rm -f \"$ROOT\"/usr/sbin/udevadm"
}


