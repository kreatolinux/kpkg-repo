sources:
 - "https://github.com/eudev-project/eudev/releases/download/v${version}/eudev-${version}.tar.gz"
sha256sum:
 - "eb69809fc0d1187f2463ab2149c53aa9f42a78e59f14ebea68eae6cb6b4fc1c3"
