name: "gdm"
version: "50.3"
release: "8"
description: "GNOME Display Manager"
sources:
 - "https://download.gnome.org/sources/gdm/${version.split('.')[0]}/gdm-${version}.tar.xz"
 - "gdm-dynamic-user.patch"
sha256sum:
 - "adac0710b8b797108ea40ea4573bd1a5e6d9b24e0a7990a994216e8dffe2d15e"
 - "f385b3e6ef089b4af7e9a478dd8b10f25deac723111b1547a8db3253d6d664f1"
depends:
 - "libtool"
 - "accountsservice"
 - "dconf"
 - "dbus"
 - "libcanberra"
 - "linux-pam"
 - "gnome-session"
 - "elogind"
build_depends:
 - "meson"

build {
 # The user unit directory is enabled: it installs
 # gnome-session@gnome-login.target.d/gnome-login.session.conf, which makes the
 # greeter's gnome-session target pull in org.gnome.Shell@gdm.service under the
 # greeter's per-user Jumpstart manager. No systemd system unit (that comes
 # from kreato-systemd-units).
 local extraArgs = "-Dlogind-provider=elogind -Dsystemd-journal=false -Dsystemdsystemunitdir=no -Dsystemduserunitdir=/usr/lib/systemd/user"
 # Adapt the LFS PAM profile to the repository's elogind provider. This is
 # unconditional: the build always uses -Dlogind-provider=elogind, and
 # jumpstart-systemd-core installs a systemctl shim, so probing for systemctl
 # would ship pam_systemd.so (which does not exist) in the greeter stack.
 exec "sed -e 's@systemd@elogind@' -e '/elogind/isession  required       pam_loginuid.so' -i data/pam-lfs/gdm-launch-environment.pam"
 # The greeter needs its own per-user Jumpstart manager (gnome-session runs
 # gnome-session@gnome-login.target through it): pam_jumpstart after
 # pam_elogind. gdm-password and gdm-autologin get it from system-session.
 exec "sed -e '/pam_elogind.so/a -session optional       pam_jumpstart.so' -i data/pam-lfs/gdm-launch-environment.pam"
 # elogind does not provide sd-varlink, so HAVE_USERDB is undefined and GDM
 # cannot allocate a dynamic greeter. Without this patch pick_username()
 # asserts and GDM aborts. The patch uses a preallocated static account.
 exec "patch -p1 < ../gdm-dynamic-user.patch"
 # gnome-login.session keeps upstream's Kiosk=true: under the systemd session
 # backend the greeter's shell is org.gnome.Shell@gdm.service, not an
 # autostart app, so the old gdm-kiosk.patch is gone.
 exec "meson setup build --prefix=/usr --libdir=/usr/lib --buildtype=release --wrap-mode=nodownload $extraArgs -Dgdm-xsession=true -Drun-dir=/run/gdm -Ddefault-pam-config=lfs -Ddbus-sys=/usr/share/dbus-1/system.d -Ddefault-path=/usr/bin:/usr/local/bin:/usr/local/sbin:/bin"
 exec "ninja -C build"
}

package {
 exec "DESTDIR=$ROOT ninja -C build install"
}

postinstall {
 # From BLFS. Idempotent: reinstalling gdm must not fail because the account
 # already exists from a previous install.
 exec "getent group gdm >/dev/null 2>&1 || groupadd -g 21 gdm"
 exec "getent passwd gdm >/dev/null 2>&1 || useradd -c 'GDM Daemon Owner' -d /var/lib/gdm -u 21 -g gdm -s /bin/false gdm"
 # BusyBox passwd has no -q; lock the account without the quiet flag.
 exec "passwd -l gdm >/dev/null 2>&1 || true"
 # Static greeter account used by the patched dynamic-user store. It must be
 # in the gdm group or pam_succeed_if rejects the greeter session.
 exec "getent group gdm-greeter >/dev/null 2>&1 || groupadd -g 120 gdm-greeter"
 exec "getent passwd gdm-greeter >/dev/null 2>&1 || useradd -u 120 -g 120 -G gdm -d /var/lib/gdm -s /bin/false -M gdm-greeter"
 exec "mkdir -p /var/lib/gdm/.config/autostart /var/lib/gdm/.local/state"
 exec "chown -R 120:120 /var/lib/gdm"
}
