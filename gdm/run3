name: "gdm"
version: "51.1.1"
release: "2"
description: "GNOME Display Manager"
sources:
 - "https://download.gnome.org/sources/gdm/${version.split('.')[0]}/gdm-${version}.tar.xz"
 - "gdm-dynamic-user.patch"
sha256sum:
 - "390ae9e7540f71db28a3dc64319a8f687f4d88bd4d5f1ff816b7a9f2249ab4aa"
 - "978136441401ea74b2612dcb2fa174b89c3eca32180ad1319d104969c4636bbc"
depends:
 - "libtool"
 - "accountsservice"
 - "dconf"
 - "dbus"
 - "libcanberra"
 - "linux-pam"
 - "gnome-session"
 - "elogind"
 - "kreato-fs-essentials"
build_depends:
 - "meson"

build {
 # Installs gnome-session@gnome-login.target.d/gnome-login.session.conf (user
 # unit dir; the system unit comes from kreato-systemd-units).
 # gdm 51 puts the PAM services in /usr/lib/pam.d unless -Dpam-services-dir
 # is pinned to /etc/pam.d, next to linux-pam's profiles.
 local extraArgs = "-Dlogind-provider=elogind -Dsystemd-journal=false -Dsystemdsystemunitdir=no -Dsystemduserunitdir=/usr/lib/systemd/user -Dpam-services-dir=/etc/pam.d"
 # LFS PAM profile switched to elogind: a systemctl probe would ship
 # pam_systemd.so, which does not exist here.
 exec "sed -e 's@systemd@elogind@' -e '/elogind/isession  required       pam_loginuid.so' -i data/pam-lfs/gdm-launch-environment.pam"
 # The greeter needs its own per-user Jumpstart manager: pam_jumpstart after
 # pam_elogind (gdm-password and gdm-autologin get it from system-session).
 exec "sed -e '/pam_elogind.so/a -session optional       pam_jumpstart.so' -i data/pam-lfs/gdm-launch-environment.pam"
 # elogind has no sd-varlink, so HAVE_USERDB is undefined: the patch uses the
 # preallocated static greeter account instead of a dynamic one.
 exec "patch -p1 < ../gdm-dynamic-user.patch"
 # Kiosk=true makes the greeter load no apps: its shell is
 # org.gnome.Shell@gdm.service, not an autostart app.
 exec "meson setup build --prefix=/usr --libdir=/usr/lib --buildtype=release --wrap-mode=nodownload $extraArgs -Dgdm-xsession=true -Drun-dir=/run/gdm -Ddefault-pam-config=lfs -Ddbus-sys=/usr/share/dbus-1/system.d -Ddefault-path=/usr/bin:/usr/local/bin:/usr/local/sbin:/bin"
 exec "ninja -C build"
}

package {
 exec "DESTDIR=$ROOT ninja -C build install"
 # Accounts and group membership ship as a sysusers.d file.
 exec "mkdir -p $ROOT/usr/lib/sysusers.d"
 write "$ROOT/usr/lib/sysusers.d/gdm.conf" """
# The gdm daemon and the account the greeter session runs as.
u gdm 21 "GDM Daemon Owner" /var/lib/gdm /bin/false
u gdm-greeter 120 "GDM Greeter" /var/lib/gdm /bin/false
m gdm-greeter gdm
"""
 exec "chmod 0644 $ROOT/usr/lib/sysusers.d/gdm.conf"
}

postinstall {
 # gdm.conf creates the daemon account and the locked greeter account.
  # kreato-sysusers ships with kreato-fs-essentials; the environment a build
  # seeds does not have it and does not need the accounts, so this is a no-op
  # there.
  exec "if [ -x \"${ROOT:-}/usr/libexec/kreato-sysusers\" ]; then \"${ROOT:-}/usr/libexec/kreato-sysusers\" \"${ROOT:-}/usr/lib/sysusers.d/gdm.conf\"; fi"
 exec "mkdir -p $ROOT/var/lib/gdm/.config/autostart $ROOT/var/lib/gdm/.local/state"
 exec "chown -R 120:120 $ROOT/var/lib/gdm"
 # The greeter runs on VT1, so no getty there.
 exec "rm -f $ROOT/etc/jumpstart/enabled/getty-tty1.kg"
}

postremove {
 # Removing gdm gives VT1 back to the getty.
 exec "mkdir -p $ROOT/etc/jumpstart/enabled"
 exec "ln -sf ../getty-tty1.kg $ROOT/etc/jumpstart/enabled/getty-tty1.kg"
}
