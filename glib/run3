name: "glib"
version: "2.90.1"
release: "3"
description: "Low-level core library that forms the basis for projects such as GTK+ and GNOME"
sources:
 - "https://download.gnome.org/sources/glib/${version.split('.')[0:2].join('.')}/glib-${version}.tar.xz"
sha256sum:
 - "93c941aa17d5eb1d53fe838365f29a8b4e539c222a256d974ec8f30fc413e396"
build_depends:
 - "meson"
 - "ninja"
 - "gobject-introspection"
 - "python-setuptools"
 - "python-packaging"
bootstrap_depends:
 - "meson"
 - "ninja"
 - "python-setuptools"
 - "python-packaging"

build {
 if "${KPKG_BOOTSTRAP}" == "1" {
   macro build --libdir=/usr/lib -Dintrospection=disabled
 } else {
   macro build --libdir=/usr/lib -Dintrospection=enabled
 }
}

package {
 macro package
}


