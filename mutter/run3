name: "mutter"
version: "51.1"
release: "6"
description: "Wayland compositor for GNOME"
extract: false
sources:
  - "https://download.gnome.org/sources/mutter/${version.split('.')[0]}/mutter-${version}.tar.xz"
  - "disable-man.patch"
sha256sum:
  - "0d311d87901dbcb94518fb89304febe30852ce5d8a4befa9f87e85c68eceefde"
  - "eadc37ef96af8e4e1235eae380a06cb9e75729f275158a0c42e3d143dd1158f8"
depends:
  - "libtool"
  - "libx11"
  - "libei"
  - "libxcvt"
  - "startup-notification"
  - "libxtst"
  - "libxkbfile"
  - "libxfixes"
  - "libxext"
  - "libxcomposite"
  - "libxcursor"
  - "libxrandr"
  - "libxau"
  - "libxinerama"
  - "libxcb"
  - "libxrender"
  - "libxdamage"
  - "libxi"
  - "xwayland"
  - "gnome-settings-daemon"
  - "graphene"
  - "libxkbcommon"
  - "pipewire"
  - "desktop-file-utils"
  - "libinput"
  - "wayland"
  - "wayland-protocols"
  - "glycin"
  - "libdisplay-info"
  - "gtk4"
  - "pango"
  - "glib"
  - "cairo"
  - "pixman"
  - "gsettings-desktop-schemas"
  - "at-spi2-core"
  - "colord"
  - "lcms2"
  - "libdrm"
  - "mesa"
  - "elogind"
  - "eudev"
  - "libgudev"
  - "libwacom"
  - "gnome-desktop"
  - "libcanberra"
  - "xkeyboard-config"
build_depends:
  - "meson"
  - "ninja"
  - "pkgconf"
  - "python"
  - "gettext"
  - "gobject-introspection"

prepare {
  # The release tarball already vendors subprojects/gvdb.
  exec "tar -xf mutter-$version.tar.xz"
  cd "mutter-$version"
  exec "patch -Np1 -i ../disable-man.patch"
}

build {
  local extraArgs = ""
  if ${exec("kpkg info xwayland")}.exit() != 0 {
    global extraArgs = "-Dxwayland=false"
  }

  exec "meson setup --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nodownload -Dtests=disabled -Dcogl_tests=false -Dclutter_tests=false -Dmutter_tests=false -Dinstalled_tests=false -Dprofiler=false -Ddocs=false -Dbash_completion=false $extraArgs build"
  exec "ninja -C build"
}

package {
  exec "DESTDIR=\"$ROOT\" ninja -C build install"
}

postinstall {
  exec "glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true"
}

