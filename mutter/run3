name: "mutter"
version: "51.0"
release: "5"
description: "Wayland compositor for GNOME"
extract: false
sources:
  - "https://gitlab.gnome.org/GNOME/mutter/-/archive/$version/mutter-$version.tar.gz"
  - "https://gitlab.gnome.org/GNOME/gvdb/-/archive/b54bc5da25127ef416858a3ad92e57159ff565b3/gvdb-b54bc5da25127ef416858a3ad92e57159ff565b3.tar.gz"
  - "disable-man.patch"
sha256sum:
  - "243f76255b7cd9a9ce56ac1d2e0fb01806d2814355a988477ebafd1a1bc2e7fc"
  - "ecc3ec39db8c301dce9bb24d8dcbab3360e42f6ce723a772f2f4acd53ad0a5a4"
  - "eadc37ef96af8e4e1235eae380a06cb9e75729f275158a0c42e3d143dd1158f8"
depends:
  - "libx11"
  - "libei"
  - "libxcvt"
  - "startup-notification"
  - "libxtst"
  - "libxkbfile"
  - "libxfixes"
  - "libxext"
  - "libxcomposite"
  - "libxcursor"
  - "libxrandr"
  - "libxau"
  - "libxinerama"
  - "libxcb"
  - "libxrender"
  - "libxdamage"
  - "libxi"
  - "xwayland"
  - "gnome-settings-daemon"
  - "graphene"
  - "libxkbcommon"
  - "pipewire"
  - "desktop-file-utils"
  - "libinput"
  - "wayland"
  - "wayland-protocols"
  - "glycin"
  - "libdisplay-info"
  - "gtk4"
  - "pango"
  - "glib"
  - "cairo"
  - "pixman"
  - "gsettings-desktop-schemas"
  - "atk"
  - "colord"
  - "lcms2"
  - "libdrm"
  - "mesa"
  - "elogind"
  - "eudev"
  - "libgudev"
  - "libwacom"
  - "gnome-desktop"
  - "libcanberra"
  - "xkeyboard-config"
build_depends:
  - "meson"
  - "ninja"
  - "pkgconf"
  - "python"
  - "gettext"
  - "gobject-introspection"

prepare {
  exec "tar -xf mutter-$version.tar.gz"
  exec "tar -xf gvdb-b54bc5da25127ef416858a3ad92e57159ff565b3.tar.gz"
  cd "mutter-$version"
  exec "mv ../gvdb-b54bc5da25127ef416858a3ad92e57159ff565b3 subprojects/gvdb"
  exec "patch -Np1 -i ../disable-man.patch"
}

build {
  local extraArgs = ""
  if ${exec("kpkg info xwayland")}.exit() != 0 {
    global extraArgs = "-Dxwayland=false"
  }

  exec "meson setup --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nodownload -Dtests=disabled -Dcogl_tests=false -Dclutter_tests=false -Dmutter_tests=false -Dinstalled_tests=false -Dprofiler=false -Ddocs=false -Dbash_completion=false $extraArgs build"
  exec "ninja -C build"
}

package {
  exec "DESTDIR=\"$ROOT\" ninja -C build install"
}

postinstall {
  exec "glib-compile-schemas /usr/share/glib-2.0/schemas"
}

