name: "dhcpcd"
version: "10.5.2"
release: "1"
description: "DHCP client"
sources:
  - "https://github.com/NetworkConfiguration/dhcpcd/releases/download/v$version/dhcpcd-$version.tar.xz"
sha256sum:
  - "3e476657fdb6eeb38b277da3a48d0ac0113ecce5858ebdcddff2b629faed52b4"
depends:
  - "eudev"
build_depends:
  - "gmake"

build {
  macro build --prefix=/usr                 --sysconfdir=/etc             --libexecdir=/usr/lib/dhcpcd  --dbdir=/var/lib/dhcpcd       --runstatedir=/run            --privsepuser=dhcpcd
  exec "make"
  exec "make -j$(nproc)"
}

package {
  exec "make DESTDIR=$ROOT install"
  exec "mkdir \"$ROOT/bin/\""
  exec "printf '#!/bin/sh\\necho \"dhcpcd:x:981:981:dhcpcd privilege separation:/:/usr/bin/nologin\" >> /etc/passwd\\necho \"dhcpcd:x:981:\" >> /etc/group\\n' > \"$ROOT/bin/install-dhcpcd-groups\""
  exec "chmod +x \"$ROOT/bin/install-dhcpcd-groups\""
  print "dhcpcd: please run install-dhcpcd-groups to install groups"
}

