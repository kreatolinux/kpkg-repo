name: "dwl"
version: "0.9"
release: "1"
description: "dwm for Wayland - dynamic tiling Wayland compositor"
sources:
  - "https://codeberg.org/dwl/dwl/releases/download/v${version}/dwl-v${version}.tar.gz"
sha256sum:
  - "51ed5da49942ca3272b6f2c4f1d7641b0b947a6eb1c264dce8a65b4d245596af"
depends:
  - "wlroots"
  - "wayland-protocols"
  - "libinput"
  - "libxkbcommon"
  - "wayland"
build_depends:
  - "wayland"

build {
  exec "make"
}

package {
  exec "make PREFIX=/usr DESTDIR=$ROOT install"
}
