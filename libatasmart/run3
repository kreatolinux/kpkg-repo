name: "libatasmart"
version: "0.19"
release: "2"
description: "disk library"
sources:
 - "https://0pointer.de/public/libatasmart-${version}.tar.xz"
sha256sum:
 - "61f0ea345f63d28ab2ff0dc352c22271661b66bf09642db3a4049ac9dbdb0f8d"
depends:
 - "eudev"
build_depends:
 - "gmake"
 - "autoconf"

prepare {
 exec "cp /usr/share/autoconf/build-aux/config.sub build-aux/config.sub"
 exec "cp /usr/share/autoconf/build-aux/config.guess build-aux/config.guess"
}

build {
 macro build --configure --build=$KPKG_TARGET
}

package {
 macro package
}

