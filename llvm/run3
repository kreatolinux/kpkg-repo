name: "llvm"
version: "21.1.2"
release: "1"
description: "The LLVM Project is a collection of modular and reusable compiler and toolchain technologies."
sources:
  - "https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/llvm-project-$version.src.tar.xz"
b2sum:
  - "1b5684586297ad637c6da0976854b24d746679e9d125a19e321dc28fa7f83949cc431f4b630e4976496660389e7abac09962c21e45b88dff7d0900ee1bda51d7"
no_chkupd: true
build_depends:
  - "cmake"
  - "ninja"
depends_llvm:
  - "gcc"

build {
  exec "cmake -S llvm -B build -DCMAKE_BUILD_TYPE=Release  -DLLVM_BUILD_LLVM_DYLIB=ON  -DLLVM_LINK_LLVM_DYLIB=ON  -DLLVM_ENABLE_RTTI=ON  -DCMAKE_INSTALL_PREFIX=/usr  -DLLVM_INSTALL_UTILS=ON  -DLLVM_INCLUDE_BENCHMARKS=OFF  -DLLVM_BINUTILS_INCDIR=/usr/include  -DLLVM_ENABLE_PROJECTS=\"lld;clang\"  -DLLVM_ENABLE_RUNTIMES=\"libcxx;libcxxabi;compiler-rt;libunwind;libclc\"  -G Ninja"
  exec "ninja -C build -j$(nproc)"
}

package {
  exec "DESTDIR=\"$ROOT\" ninja -C build install"
}

