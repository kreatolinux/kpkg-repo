name: "noto-fonts-emoji"
version: "2.051"
release: "1"
description: "Noto Color Emoji, Google's color emoji font"
sources:
 - "https://github.com/googlefonts/noto-emoji/archive/refs/tags/v${version}.tar.gz"
sha256sum:
 - "04f3d1e5605edebebac00a7a0becb390a4a3ead015066905b27935b30c18e745"
depends:
 - "fontconfig"

package {
 exec "install -Dm644 fonts/NotoColorEmoji.ttf -t \"$ROOT/usr/share/fonts/noto-emoji\""
}

postinstall {
 exec "fc-cache -f 2>/dev/null || true"
}
