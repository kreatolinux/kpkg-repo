name: "freeglut"
version: "3.8.0"
release: "2"
description: "freeglut"
sources:
  - "https://netix.dl.sourceforge.net/project/freeglut/freeglut/$version/freeglut-$version.tar.gz"
sha256sum:
  - "674dcaff25010e09e450aec458b8870d9e98c46f99538db457ab659b321d9989"
depends:
  - "mesa"
  - "libxi"
build_depends:
  - "cmake"
  - "glu"
  - "gmake"

build {
  exec "cmake  -DCMAKE_INSTALL_PREFIX=/usr  -DCMAKE_BUILD_TYPE=Release  -DCMAKE_C_STANDARD=17  -DFREEGLUT_BUILD_DEMOS=OFF   -DFREEGLUT_BUILD_STATIC_LIBS=OFF   -B build"
  exec "make -C build"
}

package {
  exec "make DESTDIR=$ROOT -C build install"
}

