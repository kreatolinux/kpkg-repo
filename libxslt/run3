name: "libxslt"
version: "1.1.45"
release: "2"
description: "XSLT processor based on libxml2"
sources:
 - "https://download.gnome.org/sources/libxslt/1.1/libxslt-${version}.tar.xz"
sha256sum:
 - "9acfe68419c4d06a45c550321b3212762d92f41465062ca4ea19e632ee5d216e"
depends:
 - "python"
 - "libxml2"
build_depends:
 - "pkgconf"
 - "gmake"

build {
  macro build --configure --disable-static --with-history --with-python=/usr/bin/python3
}

package {
 macro package
}


