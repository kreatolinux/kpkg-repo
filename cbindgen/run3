name: "cbindgen"
version: "0.29.4"
release: "1"
description: "Generate C bindings from Rust code"
sources:
 - "https://github.com/mozilla/cbindgen/archive/refs/tags/${version}.tar.gz"
sha256sum:
 - "9b5757e915cf8be523d3aca282b9b5651bafa112e14bf1ba488562ba282807d6"
build_depends:
 - "rust"

build {
 exec "cargo build --release --locked"
}

package {
 exec "install -Dm755 target/release/cbindgen $ROOT/usr/bin/cbindgen"
}
