name: "python-setuptools"
version: "68.2.2"
release: "1"
description: "Easily download, build, install, upgrade, and uninstall Python packages"
sources:
 - "https://github.com/pypa/setuptools/archive/refs/tags/v${version}.tar.gz"
sha256sum:
 - "d75a319a180cdacde13d8b37c4f8de2e8bd6325943fcb51ae3c631179879150c"
depends:
 - "python"

package {
 # python's make install can silently skip ensurepip, leaving no pip on a
 # freshly built root. Fall back exactly like the python-pip runfile does.
 if ${exec("command -v pip").exit()} != 0 {
   exec "python3 -m ensurepip"
 }
 exec "pip install . --prefix=/usr --root=\"$ROOT\""
}


