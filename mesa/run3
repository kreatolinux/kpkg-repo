name: "mesa"
version: "26.2.6"
release: "4"
description: "The 3D Graphics Library"
sources:
 - "https://archive.mesa3d.org/mesa-${version}.tar.xz"
sha256sum:
 - "b9436b3e1a8be76fbd4823dc884f90596ab7c6ac5e1867a305e66ffccfb31a92"
depends:
 - "elfutils"
 - "libxxf86vm"
 - "libglvnd"
 - "eudev"
 - "llvm"
 - "flex"
 - "libxshmfence"
 - "libxdamage"
build_depends:
 - "libdrm"
 - "libx11"
 - "libxrandr"
 - "meson"
 - "python-mako"
 - "python-pyyaml"
 - "python-pycparser"
 - "python-packaging"
 - "wayland-protocols"
 - "wayland"

build {
 macro build --libdir=/usr/lib -Dplatforms=wayland,x11 -Dgallium-drivers=v3d,vc4,freedreno,etnaviv,nouveau,svga,tegra,virgl,lima,llvmpipe,softpipe,zink -Dvulkan-drivers="" -Degl=enabled -Dgles1=disabled -Dglvnd=enabled -Dgles2=enabled -Dglx=dri -Dvalgrind=disabled -Dlibunwind=disabled -Dbuild-tests=false
}

package {
 macro package
}


