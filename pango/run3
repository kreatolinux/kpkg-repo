name: "pango"
version: "1.58.2"
release: "3"
description: "Text (i.e. glyph) layout engine library"
sources:
 - "https://download.gnome.org/sources/pango/${version.split('.')[0:2].join('.')}/pango-${version}.tar.xz"
sha256sum:
 - "342385b6ca3b7c73455d7c80a13b7dbe4489e00bc3bd4c5bd6ed4dce421e374a"
depends:
 - "glib"
 - "cairo"
 - "fribidi"
 - "fontconfig"
 - "harfbuzz"
build_depends:
 - "meson"
 - "ninja"
 - "gobject-introspection"

build {
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dintrospection=enabled -Ddocumentation=false -Dman-pages=false -Dxft=disabled -Dbuild-testsuite=false -Dbuild-examples=false
}

package {
 macro package
}


