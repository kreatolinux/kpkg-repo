name: "xdg-desktop-portal-gnome"
version: "50.0"
release: "1"
description: "GNOME backend for xdg-desktop-portal"
sources:
 - "https://download.gnome.org/sources/xdg-desktop-portal-gnome/${version.split('.')[0]}/xdg-desktop-portal-gnome-${version}.tar.xz"
sha256sum:
 - "ceeef2fb68b34b3f66a3def0a332a22a70af272641fb6c50065b7a2fde3d5759"
depends:
 - "gnome-desktop"
 - "gnome-keyring"
 - "libadwaita"
 - "xdg-desktop-portal-gtk"
 - "xdg-desktop-portal"
build_depends:
 - "meson"

build {
  # gdk-pixbuf resolves file types through the compiled shared MIME
  # database, and the build sandbox only carries its XML sources.
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"

 if ${exec("command -v systemctl")}.exit() != 0 {
  local extraArgs = "-Dsystemduserunitdir=/opt/deleteme"
 }

 macro build ${extraArgs}
}

package {
 macro package
 if ${exec("command -v systemctl")}.exit() != 0 {
  exec "rm -rf \"$ROOT/opt/deleteme\""
 }
}


