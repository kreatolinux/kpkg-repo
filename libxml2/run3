name: "libxml2"
version: "2.15.4"
release: "3"
description: "Libraries and utilities for parsing XML files"
sources:
 - "https://download.gnome.org/sources/libxml2/${version.split('.')[0:2].join('.')}/libxml2-${version}.tar.xz"
sha256sum:
 - "98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821"
depends:
 - "python"
 - "xz-utils"
build_depends:
 - "pkgconf"
 - "meson"
 - "ninja"
 - "doxygen"

build {
 # Pin libdir: meson picks lib64 when /usr/lib64 exists on the build host
 # (gcc creates it), which is not in the ld search path of the bootstrap
 # root - binaries like msgfmt then fail with 'libxml2.so.16 not found'.
 macro build --meson --libdir=/usr/lib -Dpython=enabled -Ddocs=disabled
}

package {
 macro package --meson
}


