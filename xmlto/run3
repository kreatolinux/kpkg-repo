name: "xmlto"
version: "0.0.29"
release: "3"
description: "Convert xml to many other formats"
sources:
 - "https://deb.debian.org/debian/pool/main/x/xmlto/xmlto_${version}.orig.tar.bz2"
sha256sum:
 - "6000d8e8f0f9040426c4f85d7ad86789bc88d4aeaef585c4d4110adb0b214f21"
depends:
 - "libxslt"
 - "docbook-xml"
 - "docbook-xsl"
 - "links"
build_depends:
 - "autoconf"
 - "automake"
 - "gmake"

build {
 exec "autoreconf -v -f -i"
 env CFLAGS="$CFLAGS -Wno-implicit-int"
 env LINKS="/usr/bin/links"
 exec "./configure --prefix=/usr"
 exec "make"
}

package {
 exec "make DESTDIR=$ROOT install"
}


