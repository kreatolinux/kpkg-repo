name: "gjs"
version: "1.90.1"
release: "4"
description: "Javascript bindings for GNOME"
sources:
 - "https://gitlab.gnome.org/GNOME/gjs/-/archive/${version}/gjs-${version}.tar.gz"
 - "https://gitlab.gnome.org/GNOME/gobject-introspection-tests/-/archive/67432ee4ebf74349cb3c848f73945b21a767e276/gobject-introspection-tests-67432ee4ebf74349cb3c848f73945b21a767e276.tar.gz"
sha256sum:
 - "a583792d3cd9d164f086bb1ed6a6da986ee908512b06ff1cc2f1e3ead0cbd9f5"
 - "d26c538b948a89be59616c7698f2e815d2d5bf723f3c0596f07d987b9cfb4823"
depends:
 - "glib"
 - "mozjs140"
 - "libffi"
 - "cairo"
 - "dbus"
 - "gobject-introspection"
 - "readline"
 - "dconf"
build_depends:
 - "meson"
 - "ninja"

prepare {
 exec "rmdir gjs-$version/subprojects/gobject-introspection-tests"
 exec "mv gobject-introspection-tests-67432ee4ebf74349cb3c848f73945b21a767e276 gjs-$version/subprojects/gobject-introspection-tests"
 cd "gjs-$version"
}

build {
 macro build --libdir=/usr/lib --wrap-mode=nofallback -Dskip_gtk_tests=true -Dinstalled_tests=false
}

package {
 macro package
}


