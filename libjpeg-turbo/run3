name: "libjpeg-turbo"
version: "3.2.0"
release: "2"
description: "library for jpeg"
sources:
  - "https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/$version/libjpeg-turbo-$version.tar.gz"
sha256sum:
  - "6f30092cef9fb839779646608f4ee14ae3cbac989c47fa05e841b0841f09878e"
build_depends:
  - "cmake"
  - "ninja"

build {
  exec "mkdir build"
  exec "cmake  -DCMAKE_INSTALL_PREFIX=/usr   -DCMAKE_INSTALL_LIBDIR=/usr/lib  -DENABLE_STATIC=OFF  -G Ninja  -B build"
  exec "ninja -C build"
}

package {
  exec "DESTDIR=\"$ROOT\" ninja -C build install"

}

