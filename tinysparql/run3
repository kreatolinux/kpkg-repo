name: "tinysparql"
version: "3.12.0"
release: "2"
description: "SPARQL database and triple store"
sources:
 - "https://download.gnome.org/sources/tinysparql/${version.split('.')[0:2].join('.')}/tinysparql-${version}.tar.xz"
sha256sum:
 - "40e3e3ae9811ae07a94ac7dfe8259f218679ebb1c9bc98d7ab345b2405926b57"
depends:
 - "glib"
 - "libxml2"
 - "sqlite"
 - "dbus"
 - "json-glib"
 - "libsoup"
 - "icu"
build_depends:
 - "meson"
 - "ninja"
 - "gobject-introspection"
 - "vala"
 - "python"

build {
 macro build --libdir=/usr/lib --wrap-mode=nodownload -Ddocs=false -Dman=false -Dtests=false -Davahi=disabled -Dstemmer=disabled -Dunicode_support=icu -Dsystemd_user_services=false
}

package {
 macro package
}
