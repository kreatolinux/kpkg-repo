name: "libxcrypt"
version: "4.5.2"
release: "2"
description: "Extended crypt library"
sources:
  - "https://github.com/besser82/libxcrypt/releases/download/v$version/libxcrypt-$version.tar.xz"
sha256sum:
  - "71513a31c01a428bccd5367a32fd95f115d6dac50fb5b60c779d5c7942aec071"
build_depends:
  - "gmake"

func common_build {
  local prefix = "/usr"

  env CFLAGS="$CFLAGS -Wno-error=discarded-qualifiers"

  # -Wunterminated-string-initialization only exists in GCC 15+; older
  # compilers (e.g. the foreign distro's gcc during bootstrap) reject the
  # -Wno-error flag itself and refuse to build.
  local gccmajor = "${exec("gcc -dumpversion").output()}"
  if "$gccmajor" =~ e"1[5-9].*|[2-9][0-9].*" {
    env CFLAGS="$CFLAGS -Wno-error=unterminated-string-initialization"
  }

  if "$1" != "${exec("uname -m").output()}-linux-gnu" {
    local prefix = "$prefix/$1"
    local extraArgs = "--target=$1 --host=$1"
    env CC="$1-$CC"
  }

  if "$KPKG_ARCH" != "${exec("uname -m").output()}" {
    env CFLAGS="$CFLAGS -Wno-error=pedantic"
  }

  # Ship the libcrypt.so.1 glibc-ABI soname: shadow and anything else
  # built on a foreign bootstrap root links libcrypt.so.1, and without it
  # the installed binaries die with 'libcrypt.so.1: cannot open shared
  # object file' inside the rootfs.
  macro build $extraArgs --enable-obsolete-api=yes --prefix=$prefix
  exec "make"
}

func common_package {
  macro package

  if "$1" != "${exec("uname -m").output()}-linux-gnu" {
    exec "mkdir -p $ROOT/usr/lib"
  }
}

func build_libxcrypt {
  common_build "${exec('uname -m').output()}-linux-gnu"
}

func build_aarch64_linux_gnu_libxcrypt {
  common_build "aarch64-linux-gnu"
}

package_libxcrypt {
  common_package "${exec('uname -m').output()}-linux-gnu"
}

package_aarch64_linux_gnu_libxcrypt {
  common_package "aarch64-linux-gnu"
}

