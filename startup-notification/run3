name: "startup-notification"
version: "0.12"
release: "2"
description: "startup-notification"
sources:
 - "https://www.freedesktop.org/software/startup-notification/releases/startup-notification-${version}.tar.gz"
sha256sum:
 - "3c391f7e930c583095045cd2d10eb73a64f085c7fde9d260f2652c7cb3cfbe4a"
depends:
 - "libx11"
 - "libxcb"
 - "xcb-util"
build_depends:
 - "gmake"
 - "autoconf"

prepare {
 exec "cp /usr/share/autoconf/build-aux/config.sub config.sub"
 exec "cp /usr/share/autoconf/build-aux/config.guess config.guess"
}

build {
 macro build --configure --build=$KPKG_TARGET --libdir=/usr/lib
}

package {
 macro package
}

