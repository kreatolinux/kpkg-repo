name: "dconf"
version: "51.0"
release: "2"
description: "A simple key/value storage system that is heavily optimised for reading"
sources:
 - "https://gitlab.gnome.org/GNOME/dconf/-/archive/${version}/dconf-${version}.tar.gz"
sha256sum:
 - "323e72650a6ac830f51f53a5258798c20f06afefa8f5013a9203d611fa086460"
depends:
 - "dbus"
 - "glib"
 - "vala"
build_depends:
 - "meson"
 - "ninja"
 - "python-setuptools"

build {
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dbash_completion=false -Dman=false -Dgtk_doc=false -Dvapi=true -Dsystemduserunitdir=/usr/lib/systemd/user
}

package {
 macro package
}


