name: "dconf"
version: "51.0"
release: "2"
description: "A simple key/value storage system that is heavily optimised for reading"
sources:
 - "https://gitlab.gnome.org/GNOME/dconf/-/archive/${version}/dconf-${version}.tar.gz"
 - "https://gitlab.gnome.org/GNOME/gvdb/-/archive/4758f6fb7f889e074e13df3f914328f3eecb1fd3/gvdb-4758f6fb7f889e074e13df3f914328f3eecb1fd3.tar.gz"
sha256sum:
 - "323e72650a6ac830f51f53a5258798c20f06afefa8f5013a9203d611fa086460"
 - "da3680bd38314546a915df5ea265f8c963a42ff5ddc7d69dc1b339775f05dbd6"
depends:
 - "libtool"
 - "dbus"
 - "glib"
 - "vala"
build_depends:
 - "meson"
 - "ninja"
 - "python-setuptools"

extract: false

prepare {
  exec "tar -xf dconf-$version.tar.gz"
  exec "tar -xf gvdb-4758f6fb7f889e074e13df3f914328f3eecb1fd3.tar.gz"
  cd "dconf-$version"
  exec "rm -rf subprojects/gvdb"
  exec "mv ../gvdb-4758f6fb7f889e074e13df3f914328f3eecb1fd3 subprojects/gvdb"
}

build {
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dbash_completion=false -Dman=false -Dgtk_doc=false -Dvapi=true -Dsystemduserunitdir=disabled
}

package {
 macro package
}


