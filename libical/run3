name: "libical"
version: "4.0.5"
release: "2"
description: "An implementation of iCalendar protocols and data formats"
sources:
  - "https://github.com/libical/libical/releases/download/v$version/libical-$version.tar.gz"
sha256sum:
  - "cc09a3ac41d60e6144e644bd3fcf97d47106d659c4a0b8965102581401e67c9c"
depends:
  - "glib"
build_depends:
  - "cmake"
  - "gobject-introspection"
  - "vala"

build {
  exec "cmake -DCMAKE_INSTALL_PREFIX=/usr  -DCMAKE_BUILD_TYPE=Release   -DLIBICAL_STATIC=OFF             -DLIBICAL_GOBJECT_INTROSPECTION=ON  -DLIBICAL_GLIB_VAPI=ON         -DLIBICAL_BUILD_DOCS=OFF  -B build"
  exec "cmake --build build"
}

package {
  exec "DESTDIR=\"$ROOT\" cmake --install build"
}

