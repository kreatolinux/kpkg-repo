name: "libical"
version: "4.0.6"
release: "3"
description: "An implementation of iCalendar protocols and data formats"
sources:
  - "https://github.com/libical/libical/releases/download/v$version/libical-$version.tar.gz"
sha256sum:
  - "2e3729cb69c282d3bb17a8d2b198af6e4bc7502fd3621c9adf573921fe9dceb0"
depends:
  - "glib"
build_depends:
  - "cmake"
  - "gobject-introspection"
  - "vala"

build {
  exec "cmake -DCMAKE_INSTALL_PREFIX=/usr  -DCMAKE_BUILD_TYPE=Release   -DLIBICAL_STATIC=OFF             -DLIBICAL_GOBJECT_INTROSPECTION=ON  -DLIBICAL_GLIB_VAPI=ON         -DLIBICAL_BUILD_DOCS=OFF  -DLIBICAL_JAVA_BINDINGS=OFF  -B build"
  exec "cmake --build build"
}

package {
  exec "DESTDIR=\"$ROOT\" cmake --install build"
}

