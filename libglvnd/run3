name: "libglvnd"
version: "1.7.0"
release: "2"
description: "The GL Vendor-Neutral Dispatch library"
sources:
 - "https://gitlab.freedesktop.org/glvnd/libglvnd/-/archive/v${version}/libglvnd-v${version}.tar.gz"
sha256sum:
 - "2b6e15b06aafb4c0b6e2348124808cbd9b291c647299eaaba2e3202f51ff2f3d"
depends:
 - "libx11"
 - "libxext"
 - "xorgproto"
build_depends:
 - "meson"
 - "ninja"

build {
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dx11=enabled -Dglx=enabled
}

package {
 macro package
}


