name: "vte"
version: "0.84.1"
release: "2"
description: "Visual Terminal Emulator widget"
sources:
 - "https://download.gnome.org/sources/vte/${version.split('.')[0:2].join('.')}/vte-${version}.tar.xz"
sha256sum:
 - "aca1caa8478aebcdbb1d67897fb3511eb7601debae6810e16a15b6fa25f31ac8"
depends:
 - "libtool"
 - "gtk3"
 - "pcre"
 - "fribidi"
 - "gtk4"
 - "gnutls"
 - "simdutf"
build_depends:
 - "meson"
 - "gobject-introspection"
 - "vala"

build {
  # gdk-pixbuf resolves file types through the compiled shared MIME
  # database, and the build sandbox only carries its XML sources.
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"

 if ${exec("command -v systemctl")}.exit() != 0 {
  env extraArgs="-D_systemd=false"
 }

 macro build ${extraArgs} --libdir=/usr/lib --wrap-mode=nodownload -Ddocs=false -Dgtk4=true
}

package {
 macro package
}


