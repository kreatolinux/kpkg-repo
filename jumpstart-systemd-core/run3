name: "jumpstart-systemd-core"
version: "0.1.0"
release: "5"
description: "systemd compatibility core for Jumpstart (systemctl, journalctl, unit files)"
no_chkupd: true
license:
  - "GPL-3.0-or-later"
  - "LGPL-3.0-or-later"
# No upstream release exists (the repo is not public), so the source ships here;
# make-sdcore-tarball.sh regenerates it and the sum.
# Layout: jumpstart-systemd-core-$version/{jumpstart-systemd-core,src-2/libs/jumpstartcore},
# which is what the core's nim.cfg --path expects.
sources:
  - "jumpstart-systemd-core-$version.tar.gz"
sha256sum:
  - "c287812d10ca169f45cc968aa1b09af8dadcb2c84d185eb546c42d5f280fad5e"
extract: false
depends:
  - "jumpstart"
build_depends:
  - "nim"
  - "gmake"

# No `conflicts: systemd`: elogind declares `replaces: systemd`, so the conflict
# would block exactly the systems this core is for. Both ship systemctl and
# journalctl; kpkg reports that overlap if both are ever installed.

prepare {
  exec "tar -oxf jumpstart-systemd-core-$version.tar.gz"
  cd "jumpstart-systemd-core-$version/jumpstart-systemd-core"
}

build {
  exec "make build NIMFLAGS='-d:release --threads:off --nimcache:nimcache'"
}

package {
  # Exactly `make install`. SBINDIR=/usr/bin: /usr/sbin and /sbin are symlinks to
  # /usr/bin. umask/chmod: Jumpstart rejects a group/other-writable core tree.
  exec "umask 022 && make install DESTDIR=\"$ROOT\" PREFIX=/usr SBINDIR=/usr/bin NIMFLAGS='-d:release --threads:off --nimcache:nimcache'"
  exec "chmod -R go-w \"$ROOT/usr/lib/jumpstart\""
  # Jumpstart owns poweroff, reboot and halt (usr/bin/<name> -> jumpctl) so that
  # they work on an image without this core too; keep its links, not ours.
  exec "rm -f \"$ROOT/usr/bin/poweroff\" \"$ROOT/usr/bin/reboot\" \"$ROOT/usr/bin/halt\""

  # Enable the core: empty 0644 files named after the cores in a 0755 directory.
  exec "install -d -m 0755 \"$ROOT/etc/jumpstart/cores/enabled\""
  exec "touch \"$ROOT/etc/jumpstart/cores/enabled/systemd\" \"$ROOT/etc/jumpstart/cores/enabled/serviceHandler\""
  exec "chmod 0644 \"$ROOT/etc/jumpstart/cores/enabled/systemd\" \"$ROOT/etc/jumpstart/cores/enabled/serviceHandler\""
  # Every user daemon (`jumpstart --user`) loads this core too, from the site
  # default enabled set, while the user has no ~/.config/jumpstart/cores/enabled
  # of their own; it provides org.freedesktop.systemd1 for gnome-session.
  exec "install -d -m 0755 \"$ROOT/etc/jumpstart/users\" \"$ROOT/etc/jumpstart/users/cores\" \"$ROOT/etc/jumpstart/users/cores/enabled\""
  exec "touch \"$ROOT/etc/jumpstart/users/cores/enabled/systemd\""
  exec "chmod 0644 \"$ROOT/etc/jumpstart/users/cores/enabled/systemd\""

  # The manager applies no presets and offline systemctl cannot see the core's
  # own units, so they are linked here the way `systemctl enable` would.
  exec "install -d -m 0755 \"$ROOT/etc/systemd/system/sysinit.target.wants\" \"$ROOT/etc/systemd/system/timers.target.wants\" \"$ROOT/etc/systemd/system/multi-user.target.wants\""
  for u in ["systemd-sysusers.service", "systemd-tmpfiles-setup.service"] {
    exec "ln -sf /usr/lib/jumpstart/cores/systemd/share/units/$u \"$ROOT/etc/systemd/system/sysinit.target.wants/$u\""
  }
  exec "ln -sf /usr/lib/jumpstart/cores/systemd/share/units/systemd-tmpfiles-clean.timer \"$ROOT/etc/systemd/system/timers.target.wants/systemd-tmpfiles-clean.timer\""
  exec "ln -sf /usr/lib/jumpstart/cores/systemd/share/units/systemd-user-sessions.service \"$ROOT/etc/systemd/system/multi-user.target.wants/systemd-user-sessions.service\""
  # No getty@tty1: GDM's greeter runs on VT1; kreato-fs-essentials ships the gettys.
  exec "ln -sf /usr/lib/jumpstart/cores/systemd/share/units/graphical.target \"$ROOT/etc/systemd/system/default.target\""

  # Distribution policy for units other packages ship; read by `systemctl preset`.
  # Built with echo, not `write`: Kongue's `write` stores literal backslash-n.
  exec "install -d -m 0755 \"$ROOT/usr/lib/systemd/system-preset\" \"$ROOT/usr/lib/systemd/user-preset\""
  exec "echo '# Kreato Linux system units (jumpstart-systemd-core)' > \"$ROOT/usr/lib/systemd/system-preset/80-kreato.preset\""
  for u in ["dbus.service", "elogind.service", "elogind-userdbd.socket", "systemd-udevd.service", "systemd-udev-trigger.service", "polkit.service", "accounts-daemon.service", "upower.service", "NetworkManager.service", "gdm.service", "sshd.service", "dev-shm.mount", "systemd-sysusers.service", "systemd-tmpfiles-setup.service", "systemd-tmpfiles-clean.timer", "systemd-user-sessions.service"] {
    exec "echo 'enable $u' >> \"$ROOT/usr/lib/systemd/system-preset/80-kreato.preset\""
  }
  exec "echo '# Kreato Linux user units (jumpstart-systemd-core)' > \"$ROOT/usr/lib/systemd/user-preset/80-kreato.preset\""
  for u in ["pipewire.socket", "pipewire-pulse.socket", "wireplumber.service"] {
    exec "echo 'enable $u' >> \"$ROOT/usr/lib/systemd/user-preset/80-kreato.preset\""
  }
  exec "chmod 0644 \"$ROOT/usr/lib/systemd/system-preset/80-kreato.preset\" \"$ROOT/usr/lib/systemd/user-preset/80-kreato.preset\""
}

postinstall {
  # Units owned by other packages: apply the preset only to those installed.
  # No --root: the core's `--root=/` resolves to relative paths.
  for u in ["dbus.service", "elogind.service", "elogind-userdbd.socket", "systemd-udevd.service", "systemd-udev-trigger.service", "polkit.service", "accounts-daemon.service", "upower.service", "NetworkManager.service", "gdm.service", "sshd.service", "dev-shm.mount"] {
    exec "if [ -e /etc/systemd/system/$u ] || [ -e /usr/lib/systemd/system/$u ]; then /usr/bin/systemctl preset $u || echo 'jumpstart-systemd-core: could not preset $u'; fi"
  }
  # Offline systemctl has no --global: link user units as their [Install] does.
  for u in ["pipewire.socket", "pipewire-pulse.socket"] {
    exec "if [ -e /usr/lib/systemd/user/$u ]; then mkdir -p -m 0755 /etc/systemd/user/sockets.target.wants && ln -sf /usr/lib/systemd/user/$u /etc/systemd/user/sockets.target.wants/$u; fi"
  }
  exec "if [ -e /usr/lib/systemd/user/wireplumber.service ]; then mkdir -p -m 0755 /etc/systemd/user/pipewire.service.wants && ln -sf /usr/lib/systemd/user/wireplumber.service /etc/systemd/user/pipewire.service.wants/wireplumber.service; fi"
}
