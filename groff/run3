name: "groff"
version: "1.25.0"
release: "1"
description: "GNU implementation of the traditional Unix document formatting tools"
sources:
 - "https://ftp.gnu.org/gnu/groff/groff-${version}.tar.gz"
sha256sum:
 - "24d103a07eb79e418963bce206c8771b649871f83bda2fd4c2e65529c1c56921"
depends:
 - "bison"
 - "perl"
build_depends:
 - "gmake"

build {
 macro build --configure
}

package {
 macro package
 exec "rm -rf \"$ROOT/usr/share/info/dir\""
}

