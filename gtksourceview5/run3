name: "gtksourceview5"
version: "5.22.0"
release: "1"
description: "Source code editing widget for GTK 4"
sources:
 - "https://download.gnome.org/sources/gtksourceview/${version.split('.')[0:2].join('.')}/gtksourceview-${version}.tar.xz"
sha256sum:
 - "3ebce33c781e65590a450ecd3ffade480d8e3135b52ee996f1620d6c7dffbbff"
depends:
 - "glib"
 - "gtk4"
 - "pango"
 - "fontconfig"
 - "fribidi"
 - "libxml2"
 - "pcre"
build_depends:
 - "meson"
 - "ninja"
 - "gobject-introspection"
 - "vala"

build {
  # gdk-pixbuf resolves file types through the compiled shared MIME
  # database, and the build sandbox only carries its XML sources.
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dintrospection=enabled -Dvapi=true -Ddocumentation=false -Dbuild-testsuite=false -Dinstall-tests=false -Dsysprof=false
}

package {
 macro package
}

postinstall {
 exec "gtk4-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true"
}
