name: "adwaita-icon-theme"
version: "51.0"
release: "2"
description: "adwaita-icon-theme"
sources:
 - "https://download.gnome.org/sources/adwaita-icon-theme/${version.split('.')[0]}/adwaita-icon-theme-${version}.tar.xz"
sha256sum:
 - "ba561cf3c96305a47179fa5605856ad695c9238ea07f7093aebd9ba80c4e323b"
depends:
 - "libtool"
 - "librsvg"
 - "gtk3"
 - "hicolor-icon-theme"
build_depends:
 - "meson"
 - "ninja"

build {
  # gdk-pixbuf resolves file types through the compiled shared MIME
  # database, and the build sandbox only carries its XML sources.
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"
 macro build --wrap-mode=nodownload
}

package {
 macro package
}


