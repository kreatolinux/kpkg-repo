name: "gnome-online-accounts"
version: "3.58.1"
release: "5"
description: "The GNOME online account manager"
sources:
 - "https://gitlab.gnome.org/GNOME/gnome-online-accounts/-/archive/${version}/gnome-online-accounts-${version}.tar.gz"
sha256sum:
 - "4ef2c9a3f875d4134cb8322495fd099136bae7935b850dd513155851454f0525"
depends:
 - "libtool"
 - "json-glib"
 - "rest"
 - "libadwaita"
build_depends:
 - "meson"
 - "vala"
 - "gobject-introspection"
 - "webkitgtk3"

build {
  # gdk-pixbuf resolves file types through the compiled shared MIME
  # database, and the build sandbox only carries its XML sources.
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"
 macro build --libdir=/usr/lib --wrap-mode=nodownload -Dkerberos=false -Ddocumentation=false -Dman=false
}

package {
 macro package
}


