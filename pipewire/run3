name: "pipewire"
version: "1.6.9"
release: "3"
description: "Sound server"
sources:
  - "https://github.com/PipeWire/pipewire/archive/$version/pipewire-$version.tar.gz"
sha256sum:
  - "dbc3624cf71215c26a22fc98f6f71f7b8599f5f6b415eab4a5c90ca96c170c7c"
depends:
  - "glib"
  - "dbus"
build_depends:
  - "meson"
build {
  exec "meson setup --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nodownload -Dsession-managers=[] -Ddbus=enabled -Dtests=disabled -Dinstalled_tests=disabled -Ddocs=disabled -Dman=disabled -Dexamples=disabled -Dsystemd-system-service=disabled -Dsystemd-user-service=disabled build"
  exec "ninja -C build"
}

package {
  exec "DESTDIR=\"$ROOT\" ninja -C build install"
}

