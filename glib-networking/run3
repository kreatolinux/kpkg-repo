name: "glib-networking"
version: "2.90.1"
release: "2"
description: "Network extensions for GLib"
sources:
 - "https://download.gnome.org/sources/glib-networking/${version.split('.')[0:2].join('.')}/glib-networking-${version}.tar.xz"
sha256sum:
 - "ea95636590098355a05e3027579dba1a9a950b05e456b2488ea03d82e4b6c18a"
depends:
 - "glib"
 - "gnutls"
 - "gsettings-desktop-schemas"
 - "ca-certificates"
build_depends:
 - "meson"
 - "ninja"

build {
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dlibproxy=disabled -Dgnutls=enabled -Dinstalled_tests=false
}

package {
 macro package
}


