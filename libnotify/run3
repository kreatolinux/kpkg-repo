name: "libnotify"
version: "0.8.9"
release: "3"
description: "Notification library"
sources:
 - "https://download.gnome.org/sources/libnotify/${version.split('.')[0:2].join('.')}/libnotify-${version}.tar.xz"
sha256sum:
 - "c906bb084027ea512f94a60fbfc0cc8d4f17e4b4d525bed370d07a6d8714c923"
depends:
 - "gdk-pixbuf"
 - "gobject-introspection"
build_depends:
 - "meson"
 - "ninja"

build {
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dtests=false -Dintrospection=enabled -Dman=false -Dgtk_doc=false -Ddocbook_docs=disabled
}

package {
 macro package
}


