name: "libnotify"
version: "0.8.8"
release: "2"
description: "Notification library"
sources:
 - "https://gitlab.gnome.org/GNOME/libnotify/-/archive/${version}/libnotify-${version}.tar.gz"
sha256sum:
 - "aa0f94ed3dcc45ce169f4987d2c3275f7ece17523bb7ffe41596c053606a1a00"
depends:
 - "gdk-pixbuf"
 - "gobject-introspection"
build_depends:
 - "meson"
 - "ninja"

build {
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dtests=false -Dintrospection=enabled -Dman=false -Dgtk_doc=false -Ddocbook_docs=disabled
}

package {
 macro package
}


