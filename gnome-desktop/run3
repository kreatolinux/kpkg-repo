name: "gnome-desktop"
version: "51.0"
release: "1"
description: "Libraries for GNOME desktop"
sources:
 - "https://download.gnome.org/sources/gnome-desktop/51/gnome-desktop-${version}.tar.xz"
sha256sum:
 - "9ebeb9f1769d3c310caeadd921ab34c8f264b92937740518b3bc859a579a6912"
depends:
 - "libtool"
 - "libdrm"
 - "gsettings-desktop-schemas"
 - "gtk3"
 - "gtk4"
 - "iso-codes"
 - "itstool"
 - "libseccomp"
 - "libxml2"
 - "xkeyboard-config"
 - "gobject-introspection"
build_depends:
 - "meson"
 - "python-setuptools"
 - "glib"

build {
  # gdk-pixbuf resolves file types through the compiled shared MIME
  # database, and the build sandbox only carries its XML sources.
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"
  # -Dqr=enabled builds libgnome-qr, required by gnome-shell 51.
  macro build --libdir=/usr/lib --wrap-mode=nodownload -Dqr=enabled
}

package {
 macro package
}
