name: "gnome-bluetooth"
version: "42.8"
release: "2"
description: "Bluetooth tools for GNOME"
sources:
 - "https://download.gnome.org/sources/gnome-bluetooth/42/gnome-bluetooth-${version}.tar.xz"
sha256sum:
 - "76c241e8ca2c9b1035364535ca26084f89fc5c0e1829510f8909583115fcc2db"
depends:
 - "bluez"
 - "gtk4"
 - "libadwaita"
 - "libnotify"
 - "upower"
