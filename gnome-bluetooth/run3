name: "gnome-bluetooth"
version: "47.2"
release: "1"
description: "Bluetooth tools for GNOME"
sources:
 - "https://download.gnome.org/sources/gnome-bluetooth/47/gnome-bluetooth-${version}.tar.xz"
sha256sum:
 - "41f20e6d6176b72590af63552b232d83f2fffdd77ecfaa5eaf32c5a4a86fad64"
depends:
 - "libtool"
 - "bluez"
 - "gtk4"
 - "libadwaita"
 - "libnotify"
 - "upower"
 - "gsound"
build_depends:
 - "meson"
 - "gobject-introspection"

build {
  # gdk-pixbuf resolves file types through the compiled shared MIME
  # database, and the build sandbox only carries its XML sources.
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"
 macro build --libdir=/usr/lib --wrap-mode=nodownload -Dgtk_doc=false
}

package {
 macro package
}


