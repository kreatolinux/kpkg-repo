name: "librsvg"
version: "2.63.2"
release: "3"
description: "SVG rendering library"
sources:
 - "https://gitlab.gnome.org/GNOME/librsvg/-/archive/${version}/librsvg-${version}.tar.gz"
sha256sum:
 - "39fd9027fe7d78fd404dec9350f845e6215d7879b8a1c46733e01ea6143ec3a6"
depends:
 - "cairo"
 - "freetype"
 - "gdk-pixbuf"
 - "glib"
 - "harfbuzz"
 - "libxml2"
 - "pango"
build_depends:
 - "rust"
 - "vala"
 - "gobject-introspection"
 - "meson"
 - "ninja"
 - "cargo-c"

build {
 macro build --libdir=/usr/lib --libexecdir=/usr/lib --default-library=shared -Dvala=enabled -Dintrospection=enabled -Ddocs=disabled -Dtests=false
}

package {
 macro package
}

postinstall {
 exec "gdk-pixbuf-query-loaders --update-cache"
}


