name: "librsvg"
version: "2.63.4"
release: "2"
description: "SVG rendering library"
sources:
 - "https://download.gnome.org/sources/librsvg/${version.split('.')[0:2].join('.')}/librsvg-${version}.tar.xz"
sha256sum:
 - "31f07d9350dad3f8964fd613c31309ac160fdef13dfac59df6fd082de78d6e8f"
depends:
 - "cairo"
 - "freetype"
 - "gdk-pixbuf"
 - "glib"
 - "harfbuzz"
 - "libxml2"
 - "pango"
build_depends:
 - "rust"
 - "vala"
 - "gobject-introspection"
 - "meson"
 - "ninja"
 - "cargo-c"

build {
  # -Dpixbuf-loader: without the SVG loader gdk-pixbuf decodes no SVG, so
  # gnome-shell/St and GTK3 show no icons.
  # gdk-pixbuf resolves file types through the compiled shared MIME
  # database, and the build sandbox only carries its XML sources.
  exec "command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true"
 macro build --libdir=/usr/lib --libexecdir=/usr/lib --default-library=shared -Dvala=enabled -Dintrospection=enabled -Dpixbuf=enabled -Dpixbuf-loader=enabled -Ddocs=disabled -Dtests=false
}

package {
 macro package
}

postinstall {
 # Register the SVG loader in loaders.cache.
 exec "gdk-pixbuf-query-loaders --update-cache 2>/dev/null || true"
}


