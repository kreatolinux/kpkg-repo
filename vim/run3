name: "vim"
version: "9.2.1172"
release: "3"
description: "Vi Improved"
sources:
 - "https://github.com/vim/vim/archive/refs/tags/v${version}.tar.gz"
sha256sum:
 - "d4f7a793d2cf80ad6bb09085746515979d049e79e5839d8b68325688b47af297"
depends:
 - "ncurses"
build_depends:
 - "gmake"

build {
 # The top-level wrapper uses $SRCDIR as its cd target; kpkg exports that
 # variable as this directory, so invoking ./configure recurses forever.
 exec "cd src && ./configure --prefix=/usr --without-local-dir"
 exec "make"
}

package {
 macro package
}


