name: "kreato-fs-essentials"
version: "0.0.2"
release: "19"
description: "Kreato Linux filesystem essentials, seperated from src/kreastrap/overlay"
no_chkupd: true
sources:
 - "overlay/"
b2sum:
 - "SKIP"
backup:
 # A build container can have a real, mount-backed /var/run. Preserve it
 # instead of trying to replace it with the FHS symlink during a reinstall;
 # fresh roots still receive the symlink from the package phase.
 - "var/run"
 - "etc/group"
 - "etc/passwd"
 - "etc/profile"
 - "etc/resolv.conf"
 - "etc/shadow"
 - "etc/shells"

# var/run is a backup path now: an existing real directory is preserved rather
# than replaced, and a fresh root receives the FHS symlink from package {}.
# Do not add preinstall/preupgrade hooks here: rootfs staging has no shell and
# kpkg refuses to run lifecycle hooks on the build host.

prepare {
 exec ":"
}

package {
 exec "cp -r etc/ $ROOT"
 # shadow must not be world-readable.
 exec "chmod 0600 $ROOT/etc/shadow"
 exec "cp -r usr/ $ROOT"
 exec "chmod 0755 $ROOT/usr/libexec/kreato-sysusers"
 exec "[ ! -d var ] || cp -r var/ $ROOT"
 # /var/run must be the FHS symlink to /run, not a directory.
 exec "rm -rf $ROOT/var/run"
 exec "mkdir -p $ROOT/var && ln -s /run $ROOT/var/run"
 exec "mkdir -p $ROOT/etc/jumpstart/enabled"
 # Only the serial console this architecture has is shipped; a hook cannot see
 # KPKG_ARCH, so the getty is enabled in postinstall instead.
 if "$KPKG_ARCH" == "aarch64" || "$KPKG_ARCH" == "arm64" {
   exec "rm -f $ROOT/etc/jumpstart/getty-ttyS0.kg"
 } else {
   exec "rm -f $ROOT/etc/jumpstart/getty-ttyAMA0.kg"
 }
}

# The image keeps its own group database: on the native core nothing applies
# sysusers.d at boot. The getty links also cover an upgrade, where the ones the
# previous release shipped are gone.
func apply_policy {
 # etc/shadow is in backup:, and a backup file that exists on the target is
 # kept, so an upgrade would otherwise keep the old mode.
 exec "[ ! -e \"${ROOT:-}/etc/shadow\" ] || chmod 0600 \"${ROOT:-}/etc/shadow\""
  # kreato-sysusers ships with kreato-fs-essentials; the environment a build
  # seeds does not have it and does not need the accounts, so this is a no-op
  # there.
  exec "if [ -x \"${ROOT:-}/usr/libexec/kreato-sysusers\" ]; then \"${ROOT:-}/usr/libexec/kreato-sysusers\" \"${ROOT:-}/usr/lib/sysusers.d/kreato-base.conf\"; fi"
 exec "mkdir -p $ROOT/etc/jumpstart/enabled"
 # A display manager on VT1 owns tty1; its package removes this link, so do not
 # put it back on an upgrade.
 exec "[ -e $ROOT/usr/bin/gdm ] || ln -sf ../getty-tty1.kg $ROOT/etc/jumpstart/enabled/getty-tty1.kg"
 exec "ln -sf ../getty-tty2.kg $ROOT/etc/jumpstart/enabled/getty-tty2.kg"
 exec "ln -sf ../getty-tty3.kg $ROOT/etc/jumpstart/enabled/getty-tty3.kg"
 exec "ln -sf ../getty-tty4.kg $ROOT/etc/jumpstart/enabled/getty-tty4.kg"
 exec "ln -sf ../getty-tty5.kg $ROOT/etc/jumpstart/enabled/getty-tty5.kg"
 exec "ln -sf ../getty-tty6.kg $ROOT/etc/jumpstart/enabled/getty-tty6.kg"
 exec "[ ! -f $ROOT/etc/jumpstart/getty-ttyAMA0.kg ] || ln -sf ../getty-ttyAMA0.kg $ROOT/etc/jumpstart/enabled/getty-ttyAMA0.kg"
 exec "[ ! -f $ROOT/etc/jumpstart/getty-ttyS0.kg ] || ln -sf ../getty-ttyS0.kg $ROOT/etc/jumpstart/enabled/getty-ttyS0.kg"
}

postinstall {
 apply_policy
}

postupgrade {
 apply_policy
}
