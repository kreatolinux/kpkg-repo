name: "kreato-fs-essentials"
version: "0.0.2"
release: "8"
description: "Kreato Linux filesystem essentials, seperated from src/kreastrap/overlay"
sources:
 - "overlay/"
b2sum:
 - "SKIP"
backup:
 - "etc/group"
 - "etc/passwd"
 - "etc/profile"
 - "etc/resolv.conf"
 - "etc/shadow"
 - "etc/shells"

prepare {
 exec ":"
}

package {
 exec "cp -r etc/ $ROOT"
 exec "mkdir -p $ROOT/etc/jumpstart/enabled"
 # Give the serial console a login prompt. Which device is the console
 # depends on the architecture; enabling the wrong one just makes getty
 # fail to open a nonexistent tty.
 if "$KPKG_ARCH" == "aarch64" || "$KPKG_ARCH" == "arm64" {
   exec "ln -sf ../getty-ttyAMA0.kg $ROOT/etc/jumpstart/enabled/getty-ttyAMA0.kg"
 } else {
   exec "ln -sf ../getty-ttyS0.kg $ROOT/etc/jumpstart/enabled/getty-ttyS0.kg"
 }
 exec "ln -sf ../getty-tty1.kg $ROOT/etc/jumpstart/enabled/getty-tty1.kg"
 exec "ln -sf ../getty-tty2.kg $ROOT/etc/jumpstart/enabled/getty-tty2.kg"
 exec "ln -sf ../getty-tty3.kg $ROOT/etc/jumpstart/enabled/getty-tty3.kg"
 exec "ln -sf ../getty-tty4.kg $ROOT/etc/jumpstart/enabled/getty-tty4.kg"
 exec "ln -sf ../getty-tty5.kg $ROOT/etc/jumpstart/enabled/getty-tty5.kg"
 exec "ln -sf ../getty-tty6.kg $ROOT/etc/jumpstart/enabled/getty-tty6.kg"
}


