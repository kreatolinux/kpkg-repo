name: js115
version: 115.6.0
release: 3
description: "Spidermonkey JavaScript and WebAssembly Engine"
sources:
 - "https://archive.mozilla.org/pub/firefox/releases/${version}esr/source/firefox-${version}esr.source.tar.xz"
 - "patches/D190288.1705253813.diff"
 - "https://github.com/mozilla-firefox/firefox/commit/d497aa4f770ca02f6083e93b94996a8fe32c2ff4.patch"
sha256sum:
 - "66d7e6e5129ac8e6fe83e24227dc7bb8dc42650bc53b21838e614de80d22bc66"
 - "88d8b9bf64a36bf9a2e9477f86585f18c34e1c97f6e08f1d3215d02a6e5619cd"
 - "02f85d18a1c734b8f3354184c7a35c486a772705f651f9d6ddf20ba5cdaf3621"
depends:
 - readline
 - zlib
 - icu
build_depends:
 - rust
 - python
 - llvm
 - which
 - git
 - gmake
no_chkupd: true

prepare {
  exec "git apply ../D190288.1705253813.diff"
  exec "git apply ../d497aa4f770ca02f6083e93b94996a8fe32c2ff4.patch"
}

build {
  exec "mkdir obj"
  cd "obj"
  exec "CC=clang CXX=clang++ sh ../js/src/configure --host=${KPKG_ARCH}-unknown-linux-gnu --prefix=/usr  --with-intl-api           --with-system-zlib        --with-system-icu         --disable-jemalloc        --disable-debug-symbols   --enable-readline"
  exec "make -j${exec(\"nproc\").output()}"
}

package {
  exec "make install"
}
