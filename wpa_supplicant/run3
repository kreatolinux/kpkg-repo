name: "wpa_supplicant"
version: "2.12"
release: "3"
description: "WPA client"
sources:
  - "https://w1.fi/releases/wpa_supplicant-$version.tar.gz"
sha256sum:
  - "08e23937e16d0155e55cab2b51f51fbe10d80a1aa91c4e15442645059b737ef6"
depends:
  - "openssl"
  - "dbus"
  - "libnl"
  - "libxml2"
  - "readline"
  - "pkgconf"
build_depends:
  - "gmake"

build {
  exec "printf '%s\\n' 'CONFIG_BACKEND=file' 'CONFIG_CTRL_IFACE=y' 'CONFIG_DEBUG_FILE=y' 'CONFIG_DEBUG_SYSLOG=y' 'CONFIG_DEBUG_SYSLOG_FACILITY=LOG_DAEMON' 'CONFIG_DRIVER_NL80211=y' 'CONFIG_DRIVER_WEXT=y' 'CONFIG_DRIVER_WIRED=y' 'CONFIG_EAP_GTC=y' 'CONFIG_EAP_LEAP=y' 'CONFIG_EAP_MD5=y' 'CONFIG_EAP_MSCHAPV2=y' 'CONFIG_EAP_OTP=y' 'CONFIG_EAP_PEAP=y' 'CONFIG_EAP_TLS=y' 'CONFIG_EAP_TTLS=y' 'CONFIG_IEEE8021X_EAPOL=y' 'CONFIG_IPV6=y' 'CONFIG_LIBNL32=y' 'CONFIG_PEERKEY=y' 'CONFIG_PKCS12=y' 'CONFIG_CTRL_IFACE_DBUS=y' 'CONFIG_CTRL_IFACE_DBUS_NEW=y' 'CONFIG_CTRL_IFACE_DBUS_INTRO=y' 'CONFIG_READLINE=y' 'CONFIG_SMARTCARD=y' 'CONFIG_WPS=y' 'CFLAGS += -I/usr/include/libnl3' > wpa_supplicant/.config"
  cd "wpa_supplicant/"
  exec "make BINDIR=/usr/sbin LIBDIR=/usr/lib -j$(nproc)"
}

package {
  exec "make BINDIR=/usr/sbin LIBDIR=/usr/lib DESTDIR=$ROOT install"
  # from blfs
  exec "mkdir -p $ROOT/usr/share/dbus-1/system-services"
  exec "install -v -m644 dbus/fi.w1.wpa_supplicant1.service  $ROOT/usr/share/dbus-1/system-services/"
  exec "install -v -d -m755 $ROOT/etc/dbus-1/system.d"
  exec "install -v -m644 dbus/dbus-wpa_supplicant.conf  $ROOT/etc/dbus-1/system.d/wpa_supplicant.conf"
  if ${exec("command -v systemctl")}.exit() == 0 {
    exec "mkdir -p $ROOT/usr/lib/systemd/system"
    exec "install -v -m644 systemd/*.service $ROOT/usr/lib/systemd/system/"
  }
}

