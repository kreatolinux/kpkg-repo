name: "libxmlb"
version: "0.3.29"
release: "2"
description: "A library to help create and query binary XML blobs"
sources:
 - "https://github.com/hughsie/libxmlb/releases/download/${version}/libxmlb-${version}.tar.xz"
sha256sum:
 - "448294be33bfae62f00fa66e506f1cae80237ce71b7ab6530aefa75005eeb08a"
depends:
 - "glib"
 - "gobject-introspection"
build_depends:
 - "meson"
 - "ninja"

build {
 macro build --libdir=/usr/lib --default-library=shared --wrap-mode=nodownload -Dgtkdoc=false -Dintrospection=true -Dtests=false -Dstemmer=false
}

package {
 macro package
}


